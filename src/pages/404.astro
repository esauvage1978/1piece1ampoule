---
import Layout from '../layouts/Layout.astro';
import QuickAccessHub from '../components/QuickAccessHub.astro';
import CrossLinkOutilsDepannage from '../components/CrossLinkOutilsDepannage.astro';
import { QUICK_ACCESS_STATIC } from '../data/siteQuickAccess.mjs';

const outils = QUICK_ACCESS_STATIC.filter((i) => i.category === 'outil');
---
<Layout title="Page introuvable — 1 pièce 1 ampoule" description="Cette page n’existe pas ou a été déplacée. Retrouvez nos configurateurs d’éclairage, calculateurs et le répertoire de codes erreurs en un clic." noindex={true}>
  <section class="mt-10 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold text-amber-700">Erreur 404</p>
    <h1 class="mt-2 text-3xl font-extrabold text-stone-900 sm:text-4xl">Cette page n’existe pas</h1>
    <p class="mt-4 max-w-2xl text-stone-600">
      Pas de panique : utilisez la recherche ci-dessous pour accéder directement à un simulateur, un guide ou une fiche code erreur.
      Vous pouvez aussi revenir à l’<a class="font-semibold text-amber-700 underline" href="/">accueil</a>.
    </p>
  </section>

  <QuickAccessHub mode="404" showButtons={false} id="quick-access-404" />

  <section class="mt-10">
    <h2 class="text-2xl font-bold text-stone-900">Nos configurateurs &amp; calculateurs (accès en 1 clic)</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {outils.map((o) => (
        <a href={o.href} class="rounded-xl border border-stone-200 bg-white p-4 shadow-sm hover:border-amber-300 hover:bg-amber-50">
          <span class="font-semibold text-stone-900">{o.title}</span>
        </a>
      ))}
    </div>
    <p class="mt-3 text-sm text-stone-600">
      <a class="font-semibold text-amber-700" href="/outils/">Voir tous les outils →</a>
    </p>
  </section>

  <section class="mt-10 rounded-3xl border border-red-100 bg-red-50/50 p-6 sm:p-8">
    <h2 class="text-2xl font-bold text-stone-900">Vous cherchez un code erreur ou une panne ?</h2>
    <p class="mt-2 max-w-2xl text-stone-600">
      Pont Hue, ampoule qui clignote, variateur incompatible, module Shelly ou passerelle IKEA : le répertoire regroupe symptômes, codes et solutions pas à pas.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a class="rounded-xl bg-red-700 px-5 py-3 font-semibold text-white shadow hover:bg-red-800" href="/guides/depannage-ampoules-connectees-led/">Répertoire codes erreurs →</a>
      <a class="rounded-xl border border-stone-300 bg-white px-5 py-3 font-semibold text-stone-800 hover:bg-stone-50" href="/pieces/">Pièces &amp; choix d’ampoules →</a>
      <a class="rounded-xl border border-stone-300 bg-white px-5 py-3 font-semibold text-stone-800 hover:bg-stone-50" href="/guides/consommables-accessoires-eclairage-led/">Accessoires &amp; SAV →</a>
    </div>
  </section>

  <CrossLinkOutilsDepannage variant="vers-outils" />

  <p class="mt-10 text-center">
    <a class="inline-flex rounded-xl bg-stone-900 px-6 py-3 font-semibold text-white hover:bg-stone-800" href="/contact/">Nous contacter</a>
  </p>
</Layout>
