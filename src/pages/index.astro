---
import { COMPARATIFS } from '../content/comparatifs';
import { ARTICLES } from '../content/articles';
import Layout from '../layouts/Layout.astro';
import { PIECES } from '../content/pieces';
import ComparisonTable from '../components/ComparisonTable.astro';
import { PRODUCTS } from '../content/products';
import WinterBlock from '../components/WinterBlock.astro';
import QuickAccessHub from '../components/QuickAccessHub.astro';
import BlackFridayStrip from '../components/BlackFridayStrip.astro';
const short = (t: string) => t.split(/[:(?]/)[0].replace(/^Quelle ampoule (choisir )?pour (une |un |le |la |les )?/i, '').trim();
const featured = ['B01KHIM7OG', 'B0F62SG8Z9', 'B0FJ8VXHRX'].map((a) => PRODUCTS[a]);
const problems = ['ampoule-led-qui-clignote', 'ampoule-led-reste-allumee-faiblement', 'ampoule-led-gresille-bourdonne', 'ampoule-dimmable-ou-non', 'ampoule-led-chauffe-duree-de-vie', 'e27-ou-b22'].map((s) => ARTICLES.find((a) => a.slug === s)!);
---
<Layout title="Choisir son ampoule LED : guide pièce par pièce (2026)" description="Quelle ampoule choisir pour chaque pièce ? Zones, lumens, Kelvin, IRC, culots, dépannage et comparatifs 2026 des meilleures ampoules, spots et rubans LED.">
  <section class="mt-8 overflow-hidden rounded-[2rem] bg-stone-900 text-white shadow-xl">
    <div class="grid items-center gap-8 p-7 sm:p-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-amber-300">💡 Guides indépendants · mis à jour octobre 2026</p>
        <h1 class="mt-4 text-4xl leading-[1.05] text-white sm:text-5xl">La bonne ampoule,<br/><span class="text-amber-400">dans chaque pièce.</span></h1>
        <p class="mt-4 max-w-xl text-lg text-stone-300">On découpe ta pièce en zones (travail, ambiance, circulation) et on te dit quelle teinte, combien de lumens et quel produit choisir. Simple, sans jargon.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="rounded-xl bg-amber-500 px-5 py-3 font-semibold text-white shadow hover:bg-amber-600" href="/pieces/">Choisir ma pièce →</a>
          <a class="rounded-xl bg-white/10 px-5 py-3 font-semibold text-white hover:bg-white/20" href="/meilleur/">Voir les comparatifs</a>
        </div>
        <ul class="mt-7 grid grid-cols-3 gap-3 text-center text-xs text-stone-300">
          <li class="rounded-xl bg-white/5 p-3"><strong class="block text-xl text-white">{PIECES.length}</strong>pièces détaillées</li>
          <li class="rounded-xl bg-white/5 p-3"><strong class="block text-xl text-white">{COMPARATIFS.length}</strong>comparatifs</li>
          <li class="rounded-xl bg-white/5 p-3"><strong class="block text-xl text-white">{ARTICLES.length}</strong>conseils & dépannages</li>
        </ul>
      </div>
      <img src="/illustrations/salon.svg?v=3" alt="Salon éclairé par zones : plafonnier, ruban TV, lampadaire de lecture, applique" width="1200" height="780" class="w-full rounded-2xl ring-1 ring-white/10" loading="eager" />
    </div>
  </section>

  <QuickAccessHub mode="home" />

  <div class="mt-8">
    <BlackFridayStrip locale="fr" />
  </div>

  <WinterBlock lang="fr" />

  <section class="mt-10 rounded-3xl border border-emerald-200 bg-white p-6 shadow-sm">
    <h2 class="text-2xl font-bold text-stone-900">Repeindre ? Pensez à la lumière</h2>
    <p class="mt-2 max-w-2xl text-sm text-stone-600">Notre rubrique peinture explique types, finitions et préparation — et comment la teinte réagit sous vos ampoules (Kelvin, IRC).</p>
    <a class="mt-4 inline-flex font-semibold text-emerald-800 underline" href="/peinture/">Ouvrir le guide peinture</a>
  </section>

  <section class="mt-14">
    <div class="flex items-end justify-between gap-4">
      <div><h2 class="text-3xl text-stone-900">Par pièce</h2><p class="mt-1 text-stone-600">Un schéma par pièce, les zones à éclairer et les bons produits.</p></div>
      <a class="hidden text-sm font-semibold text-amber-700 hover:text-amber-800 sm:block" href="/pieces/">Toutes les pièces →</a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {PIECES.slice(0, 9).map((p) => (
        <a href={`/pieces/${p.slug}/`} class="group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <img src={p.hero.image} alt={p.hero.imageAlt} width="1200" height="780" loading="lazy" class="aspect-[1200/640] w-full object-cover object-top" />
          <div class="p-4"><p class="font-semibold text-stone-900 group-hover:text-amber-800">{short(p.title).replace(/^./, (m) => m.toUpperCase())}</p><p class="mt-1 line-clamp-2 text-sm text-stone-500">{p.description}</p></div>
        </a>
      ))}
    </div>
    <a class="mt-4 block text-sm font-semibold text-amber-700 sm:hidden" href="/pieces/">Toutes les pièces →</a>
  </section>

  <section class="mt-14 grid gap-4 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:grid-cols-3">
    <div><p class="text-2xl">🔎</p><h3 class="mt-1 font-semibold text-stone-900">Des critères clairs</h3><p class="mt-1 text-sm text-stone-600">Lumens, Kelvin, IRC, IP : chaque recommandation est justifiée par l’usage de la zone.</p></div>
    <div><p class="text-2xl">✅</p><h3 class="mt-1 font-semibold text-stone-900">Liens vérifiés</h3><p class="mt-1 text-sm text-stone-600">Chaque produit renvoie vers une fiche Amazon.fr existante, contrôlée à chaque mise à jour.</p></div>
    <div><p class="text-2xl">🤝</p><h3 class="mt-1 font-semibold text-stone-900">Transparence</h3><p class="mt-1 text-sm text-stone-600">Liens affiliés sans surcoût pour toi. <a class="text-amber-700 underline" href="/a-propos/">Qui sommes-nous ?</a></p></div>
  </section>

  <ComparisonTable products={featured} title="Les incontournables du moment" placement="home" labels={['Ampoule E27 polyvalente', 'Spots GU10 lumineux', 'Connectée premium']} />

  <section class="mt-14 grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl text-stone-900">Un souci avec une ampoule ?</h2>
      <ul class="mt-5 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white shadow-sm">
        {problems.map((a) => <li><a href={`/articles/${a.slug}/`} class="flex items-center justify-between gap-3 px-5 py-4 font-medium text-stone-800 hover:text-amber-800"><span>{a.h1}</span><span class="text-amber-600">→</span></a></li>)}
      </ul>
      <a href="/articles/" class="mt-3 inline-block text-sm font-semibold text-amber-700">Tous les conseils →</a>
      <p class="mt-2 text-sm text-stone-600">Pour aller plus loin : <a href="/guides/" class="font-semibold text-amber-700">nos guides techniques</a> (lumens, kelvins, IP, variateurs) et <a href="/zones/" class="font-semibold text-amber-700">l’éclairage des placards, escaliers et extérieurs</a>.</p>
    </div>
    <div>
      <h2 class="text-3xl text-stone-900">Comparatifs 2026</h2>
      <ul class="mt-5 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white shadow-sm">
        {COMPARATIFS.slice(0, 6).map((c) => <li><a href={`/meilleur/${c.slug}/`} class="flex items-center justify-between gap-3 px-5 py-4 font-medium text-stone-800 hover:text-amber-800"><span>{c.h1}</span><span class="text-amber-600">→</span></a></li>)}
      </ul>
      <a href="/meilleur/" class="mt-3 inline-block text-sm font-semibold text-amber-700">Tous les comparatifs →</a>
    </div>
  </section>
</Layout>
