---
import Layout from '../layouts/Layout.astro';
import { PIECES } from '../content/pieces';
import ProductCard from '../components/ProductCard.astro';
---

<Layout
	title="Choisir son ampoule — guides & liens Amazon partenaires"
	description="Un site très visuel pour choisir ampoules et luminaires, pièce par pièce. Guides techniques (lumens, Kelvin, IRC) + liens partenaires Amazon."
>
	<section class="relative mt-10 overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/10 via-white/5 to-transparent p-8">
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_20%,rgba(251,191,36,0.25),transparent_55%),radial-gradient(circle_at_80%_20%,rgba(56,189,248,0.20),transparent_50%),radial-gradient(circle_at_50%_90%,rgba(167,139,250,0.18),transparent_55%)]"></div>

		<div class="max-w-2xl">
			<p class="text-sm font-semibold text-amber-300/90">Ampoules • Luminaires • LED • Détecteurs</p>
			<h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-5xl">Choisir son ampoule</h1>
			<p class="mt-4 text-base text-white/80 sm:text-lg">
				Des pages thématiques, pièce par pièce, pour trouver le bon éclairage et accéder à des produits adaptés via des liens partenaires Amazon.
			</p>

			<div class="mt-6 flex flex-wrap gap-2">
				<a class="rounded-xl bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/15" href="/pieces">
					Explorer par pièce
				</a>
				<a class="rounded-xl bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/15" href="/guides">
					Comprendre les bases (lumens, Kelvin…)
				</a>
				<a class="rounded-xl bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/15" href="/zones">
					Zones : placards, escaliers, extérieur…
				</a>
			</div>
		</div>
	</section>

	<section class="mt-12">
		<div class="flex items-end justify-between gap-4">
			<div>
				<h2 class="text-xl font-bold">Pages “pièce par pièce”</h2>
				<p class="mt-1 text-sm text-white/70">Des recommandations rapides + une sélection de produits cohérents.</p>
			</div>
			<a class="text-sm font-semibold text-amber-300 hover:text-amber-200" href="/pieces">Tout voir →</a>
		</div>

		<div class="mt-6 grid gap-4 md:grid-cols-3">
			{PIECES.slice(0, 3).map((p) => (
				<a
					href={`/pieces/${p.slug}`}
					class="group overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-5 hover:bg-white/10"
				>
					<div class="flex items-start justify-between gap-4">
						<div class="min-w-0">
							<p class="text-xs font-semibold text-white/60">{p.hero.eyebrow ?? 'Pièce'}</p>
							<p class="mt-1 text-base font-bold text-white">{p.title}</p>
							<p class="mt-2 line-clamp-3 text-sm text-white/70">{p.description}</p>
						</div>
						<img class="h-14 w-14 shrink-0 rounded-xl bg-white/5 p-2 ring-1 ring-inset ring-white/10" src={p.hero.image} alt={p.hero.imageAlt} />
					</div>
				</a>
			))}
		</div>
	</section>

	<section class="mt-12">
		<h2 class="text-xl font-bold">Sélections rapides (Amazon partenaire)</h2>
		<p class="mt-1 text-sm text-white/70">Des liens “produit” basés sur une recherche Amazon pertinente pour ton besoin.</p>
		<div class="mt-6 grid gap-4 md:grid-cols-2">
			<ProductCard title="Ampoules LED E27 (usage général)" subtitle="Le standard le plus courant" keywords="ampoule led e27" />
			<ProductCard title="Spots LED GU10 (cuisine, couloir)" subtitle="Idéal pour zones ciblées" keywords="spot led gu10" />
			<ProductCard title="Rubans LED (meubles, TV, déco)" subtitle="Ambiance + éclairage indirect" keywords="ruban led 24v" />
			<ProductCard title="Détecteurs de mouvement (intérieur)" subtitle="Confort + économies" keywords="detecteur de mouvement interieur plafond" />
		</div>
	</section>
</Layout>
