---
import RelatedComparatifs from '../../components/RelatedComparatifs.astro';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import BestPick from '../../components/BestPick.astro';
import { amazonProductUrl } from '../../lib/amazon';
---

<Layout type="article"
  title="Éclairage placard et dressing : LED à détecteur sans fil"
  description="Éclairer un placard ou un dressing sans travaux : réglettes LED rechargeables à . Zone Guides, comparatifs et conseils pratiques sur 1piece1ampoule.fr."
>
  <section class="mt-10">
    <div class="rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
      <p class="text-sm font-semibold text-amber-700">Zone</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Placards & dressing</h1>
      <p class="mt-4 max-w-2xl text-stone-600">
        L’objectif : voir clairement les vêtements sans te “prendre” une lumière dans les yeux. Le combo gagnant = éclairage doux + capteur + diffusion.
      </p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
        <h2 class="text-lg font-bold">Où mettre la lumière ?</h2>
        <ul class="mt-4 space-y-2 text-sm text-stone-600">
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Sous la tablette du haut, orientée vers l’intérieur.</span></li>
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Sur les côtés (profilés alu) pour une lumière uniforme.</span></li>
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Évite la source au niveau des yeux sans diffuseur.</span></li>
        </ul>
      </article>
      <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
        <h2 class="text-lg font-bold">Quel capteur ?</h2>
        <ul class="mt-4 space-y-2 text-sm text-stone-600">
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Mouvement PIR : le plus simple et courant.</span></li>
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Ouverture de porte : parfait pour placards, déclenchement net.</span></li>
          <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Rechargeable USB : pratique si pas d’alimentation.</span></li>
        </ul>
      </article>
    </div>

    <BestPick title="OUILA réglette rechargeable 60 cm à détecteur" why="Aucun câble à tirer : fixation aimantée, batterie 5 000 mAh rechargeable en USB-C, trois teintes (3000, 4000 et 6500 K) et allumage par détecteur à l’ouverture de la porte." href={amazonProductUrl('B0F18462GT')} asin="B0F18462GT" cta="Voir le prix sur Amazon" />
    <p class="mt-4 text-sm text-stone-600">Comparatif complet : <a class="underline" href="/meilleur/meilleure-lampe-detecteur-sans-fil/">lampes LED sans fil à détecteur</a>. Voir aussi <a class="underline" href="/tutoriels/eclairer-cave-sans-electricite/">éclairer une cave sans électricité</a> et <a class="underline" href="/zones/">toutes les zones</a>.</p>
    <section class="mt-10">
      <h2 class="text-xl font-bold">Produits (Amazon partenaire)</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <ProductCard title="Lumière placard rechargeable + capteur" subtitle="Pose simple" keywords="lampe placard led rechargeable detecteur mouvement" />
        <ProductCard title="Ruban LED + profilé aluminium" subtitle="Diffusion premium" keywords="profilé aluminium ruban led placard diffuseur" />
        <ProductCard title="Capteur d’ouverture porte (éclairage)" subtitle="Déclenchement net" keywords="interrupteur contact porte placard eclairage" />
        <ProductCard title="Ruban LED 24V haute densité" subtitle="Ligne de lumière régulière" keywords="ruban led 24v haute densité 4000k" />
      </div>
    </section>
  </section>
  <RelatedComparatifs />
</Layout>

