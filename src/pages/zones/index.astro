---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Zones & aménagement — Choisir son ampoule"
  description="Placards, escaliers, couloirs, extérieur : éclairages et détecteurs adaptés, avec sélections produits via liens partenaires Amazon."
>
  <section class="mt-10">
    <h1 class="text-3xl font-extrabold tracking-tight">Zones & aménagement</h1>
    <p class="mt-3 max-w-2xl text-white/75">
      Certaines zones demandent des solutions spécifiques : capteurs, éclairage indirect, rubans LED, balisage. Voici nos pages.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      <a class="rounded-2xl border border-white/10 bg-white/5 p-6 hover:bg-white/10" href="/zones/placards-dressing">
        <h2 class="text-lg font-bold">Placards & dressing</h2>
        <p class="mt-2 text-sm text-white/70">Capteurs d’ouverture/mouvement, rubans LED, barrettes.</p>
      </a>
      <a class="rounded-2xl border border-white/10 bg-white/5 p-6 hover:bg-white/10" href="/zones/escaliers">
        <h2 class="text-lg font-bold">Escaliers</h2>
        <p class="mt-2 text-sm text-white/70">Balisage, détecteurs, spots et rubans pour sécurité + style.</p>
      </a>
    </div>
  </section>
</Layout>

