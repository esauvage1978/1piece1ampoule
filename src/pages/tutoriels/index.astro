---
import Layout from '../../layouts/Layout.astro';
import { TUTORIELS } from '../../content/tutoriels';
const list = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Tutoriels éclairage pas à pas',
  itemListElement: TUTORIELS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.h1, url: `https://1piece1ampoule.fr/tutoriels/${t.slug}/` })),
};
---
<Layout title="Tutoriels éclairage LED pas à pas : calculs, pose, solutions" description="Tutoriels détaillés pour éclairer sa maison : calculer les lux d’une pièce, pose. Tutoriels Guides, comparatifs et conseils pratiques sur 1piece1ampoule.fr." schema={list}>
  <section class="mx-auto mt-10 max-w-3xl">
    <p class="text-sm font-semibold text-amber-700">Tutoriels</p>
    <h1 class="mt-2 text-3xl leading-tight text-stone-900 sm:text-4xl">Tutoriels éclairage pas à pas</h1>
    <p class="mt-4 text-lg text-stone-600">Des tutoriels complets pour passer du calcul à la pose : matériel, étapes numérotées, durée, budget, erreurs fréquentes et dépannage. Chaque calcul est détaillé pour que tu puisses l’adapter à ta pièce.</p>
    <ul class="mt-8 space-y-4">
      {TUTORIELS.map((t) => (
        <li>
          <a href={`/tutoriels/${t.slug}/`} class="block rounded-3xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-amber-300 hover:shadow-md">
            <h2 class="text-xl text-stone-900">{t.h1}</h2>
            <p class="mt-2 text-sm text-stone-600">{t.card}</p>
            <p class="mt-3 text-xs font-semibold text-amber-800">{t.timeLabel} · {t.budgetLabel} · {t.level}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
