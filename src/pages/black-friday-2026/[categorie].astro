---
import BlackFridayHub from '../../components/BlackFridayHub.astro';
import { categoryPaths } from '../../content/black-friday-2026';

export function getStaticPaths() {
  return categoryPaths('fr').map(({ params, props }) => ({
    params,
    props: { locale: 'fr' as const, catId: props.catId },
  }));
}

const { locale, catId } = Astro.props;
---
<BlackFridayHub locale={locale} catId={catId} />
