---
import { pageDates, frDate } from '../../content/dates.mjs';
import Layout from '../../layouts/Layout.astro';
import { BRIEFS } from '../../content/briefs';
import { articlePillar } from '../../content/article-pillar.mjs';
import AwinPartner from '../../components/AwinPartner.astro';
import HouseOfLampsPick from '../../components/HouseOfLampsPick.astro';
import BrandLinks from '../../components/BrandLinks.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import MobileStickyPick from '../../components/MobileStickyPick.astro';
import PageBreadcrumb from '../../components/PageBreadcrumb.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import { ARTICLES } from '../../content/articles';
import { PRODUCTS } from '../../content/products';

const mods = import.meta.glob('../../articles-md/*.md', { eager: true }) as Record<string, any>;
export function getStaticPaths() {
  return ARTICLES.map((a) => ({ params: { slug: a.slug } }));
}
const a = ARTICLES.find((x) => x.slug === Astro.params.slug)!;
const mod = mods[`../../articles-md/${a.slug}.md`];
const Content = mod.Content;
const words = (mod.rawContent?.() ?? '').split(/\s+/).length;
const minutes = Math.max(3, Math.round(words / 220));
const products = a.asins.map((x) => PRODUCTS[x]).filter(Boolean);
const related = a.related.map((s) => ARTICLES.find((x) => x.slug === s)).filter(Boolean) as typeof ARTICLES;
const faqSchema = a.faq.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : undefined;
const dates = pageDates(Astro.url.pathname);
const pillar = articlePillar(a.slug, a.category);
const breadcrumbTitle = a.h1.length > 52 ? a.short : a.h1;
---

<Layout title={a.title} description={a.description} type="article" schema={faqSchema} byline={false}>
  <PageBreadcrumb
    items={[
      { href: '/', label: 'Accueil' },
      { href: '/articles/', label: 'Articles' },
      { label: breadcrumbTitle },
    ]}
  />
  <p class="mt-3 max-w-3xl text-sm text-stone-600">
    Cet article appartient à la rubrique
    <a class="font-semibold text-amber-800 underline hover:text-amber-900" href="/articles/">conseils éclairage LED</a>
    ({a.category}). Pour le cadrage technique, consultez aussi notre
    <a class="font-semibold text-amber-800 underline hover:text-amber-900" href={pillar.href}>{pillar.label}</a>.
  </p>

  <article class="mx-auto mt-6 max-w-3xl">
    <p class="text-sm font-semibold text-amber-700">{a.category}</p>
    <h1 class="mt-2 text-3xl leading-tight text-stone-900 sm:text-[2.6rem]">{a.h1}</h1>

    {a.slug === 'lampe-de-chevet' && (
      <figure class="mt-4 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
        <img
          src="/images/house-of-lamps/lirenda-table.webp"
          alt="Lampe de chevet Lirenda en rotin naturel et blanc, posée sur une table de nuit"
          width="640"
          height="640"
          loading="eager"
          decoding="async"
          class="mx-auto max-h-64 w-full object-contain p-4"
        />
      </figure>
    )}

    {a.slug === 'ampoule-led-qui-clignote' && (
      <figure class="mt-4 overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
        <img
          src="/pins/led-clignote.png"
          alt="Ampoule LED qui clignote ou vacille : illustration pour le diagnostic douille, variateur ou interrupteur"
          width="1000"
          height="1500"
          loading="eager"
          decoding="async"
          class="max-h-56 w-full object-cover object-center sm:max-h-64"
        />
      </figure>
    )}

    {products[0] && a.slug !== 'ampoule-led-qui-clignote' && (
      <section class="mt-4 flex flex-col gap-3 rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-4 shadow-sm sm:flex-row sm:items-center">
        <ProductVisual product={products[0]} />
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wide text-amber-700">Produit cité en tête d’article</p>
          <p class="mt-1 text-sm font-semibold text-stone-900">{products[0].name}</p>
          <p class="mt-1 text-sm text-stone-600">{products[0].specs}</p>
          <div class="mt-3">
            <AmazonButton
              asin={products[0].asin}
              product={products[0].name}
              label={`Prix Amazon — ${products[0].name}`}
              placement={`article-${a.slug}-hero`}
              class="w-full min-h-11 sm:w-auto"
            />
          </div>
        </div>
      </section>
    )}

    <p class="mt-4 text-lg text-stone-600">{a.description}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-stone-200 py-3 text-sm text-stone-500">
      <span>Par <a class="font-semibold text-stone-800 hover:text-amber-700" href="/a-propos/">Emmanuel Sauvage</a></span>
      <span>Mis à jour le <time datetime={dates.modified}>{frDate(dates.modified)}</time></span>
      <span>{minutes} min de lecture</span>
    </div>
    {products[0] && (
      <a href="#selection" class="mt-6 flex items-center justify-between gap-3 rounded-2xl bg-amber-50 p-4 text-sm ring-1 ring-amber-200 hover:bg-amber-100">
        <span><strong class="text-amber-800">Pressé ?</strong> Notre sélection de {products.length} produits est en bas de l’article.</span>
        <span class="font-semibold text-amber-800">Aller à la sélection produits ↓</span>
      </a>
    )}
    {BRIEFS[a.slug] && (
      <div class="mt-6 rounded-2xl border-l-4 border-amber-500 bg-white p-4 shadow-sm ring-1 ring-stone-200" data-en-bref>
        <p class="text-sm font-bold uppercase tracking-wide text-amber-700">En bref</p>
        <p class="mt-1 text-stone-800">{BRIEFS[a.slug]}</p>
      </div>
    )}
    {a.slug === 'ampoule-led-qui-clignote' && products.length > 0 && (
      <section class="mt-6 rounded-2xl border-2 border-amber-300 bg-gradient-to-br from-amber-50 to-white p-5 shadow-sm ring-1 ring-amber-200">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <ProductVisual product={products[0]} />
          <div class="min-w-0 flex-1">
            <h2 class="text-lg font-bold text-stone-900">Ampoules et variateur compatibles LED</h2>
            <p class="mt-2 text-sm text-stone-700">
              Si le diagnostic pointe vers une ampoule bas de gamme ou un variateur inadapté, voici les références déjà citées dans cet article — avec un bouton direct vers chaque fiche Amazon.
            </p>
          </div>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {products.map((p, i) => (
            <AmazonButton
              asin={p.asin}
              product={p.name}
              label={i === 0 ? `Prix Amazon — ${p.name}` : i === 1 ? `Prix Amazon variateur Legrand — ${p.name}` : `Prix Amazon — ${p.name}`}
              placement={`article-${a.slug}-hero`}
              class="w-full min-h-11 sm:w-auto"
            />
          ))}
        </div>
        <figure class="mt-5 overflow-x-auto rounded-xl border border-stone-200 bg-white">
          <table class="w-full min-w-[480px] text-left text-sm">
            <thead class="bg-amber-50 text-stone-700">
              <tr>
                <th class="p-3">Produit</th>
                <th class="p-3">Caractéristiques</th>
                <th class="p-3">Usage</th>
              </tr>
            </thead>
            <tbody>
              {products.map((p) => (
                <tr class="border-t border-stone-100 align-top">
                  <th class="p-3 text-left font-semibold text-stone-900">{p.name}</th>
                  <td class="p-3 text-stone-600">{p.specs}</td>
                  <td class="p-3 text-stone-600">{p.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </figure>
      </section>
    )}
    <div class="prose-article mt-8"><Content /></div>
  </article>

  <div id="selection" class="mx-auto max-w-5xl scroll-mt-24">
    <ComparisonTable products={products} title="Notre sélection" placement={`article-${a.slug}`} />
    <p class="mt-3 text-xs text-stone-500">Sélection basée sur les caractéristiques annoncées par les fabricants et la cohérence avec les conseils de cet article. Liens affiliés Amazon : <a class="underline" href="/affiliation-amazon/">détails sur notre affiliation Amazon</a>.</p>
  </div>

  <BrandLinks brands={products.map((p) => p.brand)} />
  <HouseOfLampsPick />
  <AwinPartner />
  <div class="mx-auto max-w-3xl">
    {a.faq.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl text-stone-900">Questions fréquentes</h2>
        <div class="mt-4 space-y-3">
          {a.faq.map((f) => (
            <details class="group rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
              <summary class="cursor-pointer font-semibold text-stone-800">{f.q}</summary>
              <p class="mt-2 text-stone-600">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
    <section class="mt-10">
      <h2 class="text-2xl text-stone-900">À lire ensuite</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {related.map((r) => (
          <a href={`/articles/${r.slug}/`} class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300">
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{r.category}</p>
            <p class="mt-1 font-semibold leading-snug text-stone-900">{r.short}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
  {products[0] && (
    <MobileStickyPick asin={products[0].asin} product={products[0].name} placement={`article-${a.slug}-sticky`} />
  )}
</Layout>
