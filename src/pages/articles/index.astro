---
import Layout from '../../layouts/Layout.astro';
import { ARTICLES, CATEGORIES } from '../../content/articles';
const blurbs: Record<string, string> = {
  'Dépannage': 'Une ampoule qui clignote, grésille ou ne s’éteint pas ? Trouve la cause et la solution.',
  'Comparer': 'Les duels qui font hésiter en magasin, expliqués simplement.',
  'Meilleurs choix': 'Nos sélections par type d’ampoule, avec les critères qui comptent.',
  'Guides pratiques': 'Calculs, installation et idées pour bien éclairer chez toi.',
};
---
<Layout title="Conseils éclairage LED : dépannage, comparatifs et guides" description="Tous nos conseils pour choisir, installer et dépanner tes ampoules LED : clignotement, 2700K ou 4000K, GU10 ou GU5.3, lumens, ruban LED, spots…">
  <section class="mt-10">
    <p class="text-sm font-semibold text-amber-700">Conseils</p>
    <h1 class="mt-2 text-4xl text-stone-900">Conseils éclairage LED</h1>
    <p class="mt-3 max-w-2xl text-stone-600">{ARTICLES.length} articles concrets pour choisir la bonne ampoule, éviter les erreurs et régler les petits problèmes du quotidien.</p>
  </section>
  {CATEGORIES.map((c) => (
    <section class="mt-10">
      <h2 class="text-2xl text-stone-900">{c}</h2>
      <p class="mt-1 text-sm text-stone-500">{blurbs[c]}</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {ARTICLES.filter((a) => a.category === c).map((a) => (
          <a href={`/articles/${a.slug}/`} class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
            <h3 class="font-semibold leading-snug text-stone-900 group-hover:text-amber-800">{a.h1}</h3>
            <p class="mt-2 line-clamp-3 text-sm text-stone-600">{a.description}</p>
            <span class="mt-auto pt-3 text-sm font-semibold text-amber-700">Lire →</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>
