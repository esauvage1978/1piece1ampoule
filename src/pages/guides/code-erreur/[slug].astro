---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import SavWave1Compliance from '../../../components/SavWave1Compliance.astro';
import CrossLinkOutilsDepannage from '../../../components/CrossLinkOutilsDepannage.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import { getCatalogFr, urlFicheErreur } from '../../../data/errors/catalog';
import { COPY } from '../../../data/savWave1.mjs';
import { techArticle } from '../../../lib/errors-schema.mjs';

export const getStaticPaths = (async () => {
  const catalog = getCatalogFr();
  return catalog.errors.map((e) => ({
    params: { slug: e.slug },
    props: { fiche: e },
  }));
}) satisfies GetStaticPaths;

const { fiche } = Astro.props;
const url = urlFicheErreur(fiche.slug);
const publie = '2026-10-24';
const fmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'Europe/Paris' });
const publieDate = new Date('2026-10-24');

const steps = fiche.solution.split(/\n/).map((l) => l.replace(/^\d+\.\s*/, '').trim()).filter(Boolean);
const bars = '●'.repeat(fiche.difficulty) + '○'.repeat(5 - fiche.difficulty);

const faqItems = [
  {
    q: `Que signifie « ${fiche.error_code} » sur ce modèle ?`,
    a: `${fiche.symptom}${fiche.cause ? ` Cause fréquente : ${fiche.cause}` : ''}`,
  },
  {
    q: 'Puis-je réparer moi-même sans perdre la garantie ?',
    a: COPY.assist,
  },
];

const schemas = [
  techArticle({
    titre: fiche.title,
    description: `${fiche.symptom} Dépannage : difficulté ${fiche.difficulty}/5, ${fiche.estimated_time}, ${fiche.estimated_cost}.`,
    url,
    publie: publieDate,
  }),
];
---
<Layout
  type="article"
  title={`${fiche.title} : dépannage pas à pas`}
  description={`${fiche.error_code} — ${fiche.symptom.slice(0, 140)} Difficulté ${fiche.difficulty}/5, ${fiche.estimated_time}, ${fiche.estimated_cost}.`}
  schema={schemas}
>
  <article class="mt-10">
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold text-amber-700">Code erreur / panne</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{fiche.title}</h1>
      <p class="mt-3 text-sm text-stone-600">
        Code : <code class="rounded bg-stone-100 px-1.5 py-0.5">{fiche.error_code}</code>
        · Publié le <time datetime={publie}>{fmt.format(publieDate)}</time>
      </p>
      <p class="mt-4"><a class="font-semibold text-amber-700 underline" href="/guides/codes-erreurs-eclairage-connecte-depannage/">← Retour au répertoire des codes erreurs</a></p>
      <ul class="err-meta-page mt-6" aria-label="Indicateurs">
        <li><strong>Difficulté</strong> <span title={`${fiche.difficulty}/5`}>{bars}</span> ({fiche.difficulty}/5)</li>
        <li><strong>Temps estimé</strong> {fiche.estimated_time}</li>
        <li><strong>Coût estimé</strong> {fiche.estimated_cost}</li>
        <li><strong>Outils requis</strong> {fiche.tools}</li>
      </ul>
      {fiche.requires_official_sav && <p class="err-badge-sav mt-4" role="note">Intervention SAV constructeur recommandée pour ce type de panne.</p>}
      <h2 class="mt-8 text-xl font-bold">Symptôme</h2>
      <p class="mt-2 text-stone-700">{fiche.symptom}</p>
      {fiche.cause && (
        <>
          <h2 class="mt-6 text-xl font-bold">Cause probable</h2>
          <p class="mt-2 text-stone-700">{fiche.cause}</p>
        </>
      )}
      <h2 class="mt-6 text-xl font-bold">Solution pas à pas</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-stone-700">{steps.map((s) => <li>{s}</li>)}</ol>
      {fiche.safety_warning && (
        <p class="err-prudence mt-6" role="note"><strong>Prudence :</strong> {fiche.safety_warning}</p>
      )}
      <p class="mt-4 text-sm italic text-stone-600">{COPY.assist}</p>
      {fiche.brand_support_url && (
        <p class="mt-3 text-sm"><a class="font-semibold text-amber-700 underline" href={fiche.brand_support_url} rel="noopener noreferrer" target="_blank">Assistance officielle constructeur</a></p>
      )}
    </div>
  </article>
  <CrossLinkOutilsDepannage variant="vers-outils" />
  <FaqBlock title="Questions fréquentes" items={faqItems} />
  <SavWave1Compliance />
</Layout>
<style>
  .err-meta-page { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .95rem; }
  .err-badge-sav { padding: .45rem .65rem; background: #eef4ff; border-radius: 6px; font-weight: 600; color: #1e3a6e; font-size: .9rem; }
  .err-prudence { padding: .55rem .65rem; border-left: 3px solid #c45c26; background: #fff5eb; font-size: .92rem; }
</style>
