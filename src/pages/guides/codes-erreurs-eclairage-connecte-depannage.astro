---
import Layout from '../../layouts/Layout.astro';
import RepertoireCodesErreursEclairage from '../../components/RepertoireCodesErreursEclairage.astro';
import CrossLinkOutilsDepannage from '../../components/CrossLinkOutilsDepannage.astro';
import { getCatalogFr } from '../../data/errors/catalog';

const catalog = getCatalogFr();
const count = catalog.errors.length;
const productCount = catalog.products.length;
---
<Layout
  type="article"
  title={`Codes erreurs éclairage connecté et LED : ${count} fiches dépannage`}
  description={`Répertoire interactif : Philips Hue, Shelly, IKEA TRÅDFRI/DIRIGERA, Govee, Nanoleaf, WiZ, Legrand Netatmo, Schneider Wiser, variateurs LED 230 V. ${productCount} modèles, filtres croisés, solutions pas à pas.`}
>
  <section class="mt-10">
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold text-amber-700">Guide dépannage</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Codes erreurs et pannes : éclairage connecté &amp; LED</h1>
      <p class="mt-4 max-w-3xl text-stone-600">
        Pont Hue, ampoules Zigbee/Wi-Fi, modules Shelly, passerelles IKEA, rubans Govee, variateurs Legrand ou Schneider, scintillement LED 230 V : utilisez les listes ci-dessous pour trouver une fiche avec symptôme, cause, difficulté, temps, coût et procédure détaillée. Chaque panne dispose aussi d’une <strong>page dédiée indexable</strong> pour le référencement.
      </p>
      <p class="mt-3 text-sm text-stone-500">
        <a class="font-semibold text-amber-700 underline" href="/guides/ampoule-led-clignote-eteinte-gresille-depannage/">LED qui clignote éteinte ou grésille</a>
        · <a class="font-semibold text-amber-700 underline" href="/marques/philips-hue/">Philips Hue</a>
      </p>
    </div>
  </section>
  <CrossLinkOutilsDepannage variant="vers-outils" />
  <RepertoireCodesErreursEclairage />
</Layout>
