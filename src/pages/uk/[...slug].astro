---
import Layout from '../../layouts/Layout.astro';
import TrPartner from '../../components/TrPartner.astro';
import ContactIntl from '../../components/intl/ContactIntl.astro';
import PromoCodesIntl from '../../components/intl/PromoCodesIntl.astro';
import { EN_PAGES } from '../../content/en';
import { adaptEnPage } from '../../lib/en-market-adapt';
export function getStaticPaths() {
  return EN_PAGES.filter((p) => p.path !== '').map((p) => ({ params: { slug: p.path || undefined }, props: { page: p } }));
}
const { page: rawPage } = Astro.props;
const page = adaptEnPage(rawPage, 'uk');
const related = page.article ? (()=>{ const all = EN_PAGES.filter((p) => p.article && p.path !== page.path); const same = all.filter((p) => p.kicker === page.kicker); const other = all.filter((p) => p.kicker !== page.kicker); return [...same, ...other].slice(0, 4); })() : [];
---
<Layout type={page.article ? 'article' : 'website'} title={page.title} description={page.description}>
  {page.template === 'contact' ? (
  <ContactIntl lang="en" />
  ) : page.template === 'promo-codes' ? (
  <PromoCodesIntl lang="en" />
  ) : (
  <section class="mt-10">
    <div class="flex items-start gap-5 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm"><span class="hidden sm:grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 shadow-sm"><svg viewBox="0 0 24 24" class="h-9 w-9" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2V16h5v-.1c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/></svg></span><div>
      <p class="text-sm font-semibold text-amber-700">{page.kicker}</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{page.h1}</h1>
      <p class="mt-4 max-w-2xl text-stone-600">{page.lead}</p>
    </div></div>
    <div class="prose-article en-body mt-8 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-10" set:html={page.body} />
    <TrPartner />
    {related.length > 0 && (
      <nav class="mt-8 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" aria-label="Read next">
        <h2 class="text-xl font-bold text-stone-900">Read next</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {related.map((p) => <a class="block rounded-2xl border border-stone-200 bg-white p-4 hover:bg-amber-50" href={`/uk/${p.path}/`}><span class="block text-xs font-semibold uppercase tracking-wide text-amber-700">{p.kicker}</span><strong class="mt-1 block text-stone-900">{p.h1}</strong></a>)}
        </div>
      </nav>
    )}
  </section>
  )}
</Layout>
<style is:global>
  .en-body table { display: table; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: .92rem; margin: 1rem 0; background: #fff; }
  .en-body th, .en-body td { border: 1px solid #e7e5e4; padding: .45rem .6rem; text-align: left; vertical-align: top; }
  .en-body th { background: #fef3c7; color: #1c1917; }
  .en-body a { color: #b45309; font-weight: 600; }
  .en-body ul, .en-body ol { padding-left: 1.3rem; list-style: disc; } .en-body ol { list-style: decimal; }
  .en-card { border: 1px solid #e7e5e4; background: #fff; border-radius: 1rem; padding: 1rem 1.2rem; margin: 1rem 0; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
  .en-body > h2:first-child { margin-top: 0; }
  @media (max-width: 640px) { .en-body table { display: block; overflow-x: auto; } }
</style>
