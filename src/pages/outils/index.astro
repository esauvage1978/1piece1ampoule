---
import Layout from '../../layouts/Layout.astro';
import LumensKelvinIrcTool from '../../components/LumensKelvinIrcTool.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import CrossLinkOutilsDepannage from '../../components/CrossLinkOutilsDepannage.astro';
import { HIVER_FAQ } from '../../content/hiver-faq';

const autresOutils = [
  { href: '/peinture/preparation-murs-poncage-enduit-sous-couche/#calculateur', title: 'Calculateur quantité peinture', desc: 'Litres de peinture selon m², couches et rendement m²/L — rubrique peinture.' },
  { href: '/outils/convertisseur-lux-lumens-watts-surface/', title: 'Convertisseur Lux ↔ Lumens ↔ Watts', desc: 'Surface, type de pièce et couleur des murs : calculez le flux et la puissance LED dans les deux sens.' },
  { href: '/outils/equivalence-halogene-led-gu10-e27-lumens/', title: 'Équivalence halogène / LED', desc: 'Watts halogène ou incandescent → lumens LED réels, angle 36° vs 110° et IRC.' },
  { href: '/outils/calculateur-ruban-led-alimentation-24v/', title: 'Calculateur ruban LED 12V / 24V', desc: 'COB ou SMD, longueur, chute de tension, alimentation +20 % et profilé aluminium.' },
  { href: '/outils/generateur-plan-eclairage-cuisine-pdf/', title: 'Plan d’éclairage cuisine (PDF)', desc: 'Zones 500 lux plan de travail, îlot, cuisson, table et circulation : GU10, ruban 24 V, Kelvin et IRC ≥ 90.' },
  { href: '/outils/calculateur-roi-relamping-led-professionnel/', title: 'ROI relamping LED pro', desc: 'Commerce, bureau, atelier ou copro : T8, dalles 60×60, halogènes, parking Steinel — kWh, maintenance et retour.' },
];
---
<Layout title="Simulateur d’éclairage : lumens, Kelvin et IRC par pièce" description="Visualise en temps réel l’effet des lumens, de la température de couleur (Kelvin. Outil gratuit Guides, comparatifs et conseils pratiques sur 1piece1ampoule.fr.">
  <section class="mt-10">
    <p class="text-sm font-semibold text-amber-700">Outil gratuit</p>
    <h1 class="mt-2 text-3xl text-stone-900 sm:text-4xl">Simulateur d’éclairage pièce par pièce</h1>
    <p class="mt-3 max-w-3xl text-stone-600">Vois avant d’acheter : combien de lumens, quelle teinte et quel IRC pour ta pièce. Pour aller plus loin : <a class="font-semibold text-amber-700" href="/guides/lumens-vs-watts">lumens vs watts</a>, <a class="font-semibold text-amber-700" href="/guides/kelvin-temperature-couleur">Kelvin</a>, <a class="font-semibold text-amber-700" href="/guides/irc-indice-rendu-couleur">IRC</a>, <a class="font-semibold text-amber-700" href="/tutoriels/calculer-eclairage-piece-lux/">calculer l’éclairage d’une pièce</a>.</p>
  </section>
  <CrossLinkOutilsDepannage variant="vers-depannage" />
  <LumensKelvinIrcTool />
  <section class="mt-10 grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"><h2 class="text-lg text-stone-900">Garage / atelier</h2><p class="mt-2 text-sm text-stone-600">Forte intensité, blanc neutre ou froid, et IRC élevé si tu veux bien voir les détails (outils, marquages, peinture).</p></div>
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"><h2 class="text-lg text-stone-900">Salon / chambre</h2><p class="mt-2 text-sm text-stone-600">Teinte chaude et intensité moyenne, avec un variateur pour moduler le soir. Préfère plusieurs sources pour éviter les zones sombres.</p></div>
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"><h2 class="text-lg text-stone-900">Comment c’est calculé ?</h2><p class="mt-2 text-sm text-stone-600">Les plages viennent des niveaux d’éclairement usuels (lux) multipliés par une surface type. La simulation est indicative : l’écran ne reproduit pas exactement une vraie lumière.</p></div>
  </section>
  <section class="mt-10 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold">Autres outils gratuits</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {autresOutils.map((o) => (
        <a href={o.href} class="rounded-xl border border-stone-200 bg-stone-50 p-4 hover:border-amber-300 hover:bg-amber-50">
          <h3 class="font-semibold text-stone-900">{o.title}</h3>
          <p class="mt-1 text-sm text-stone-600">{o.desc}</p>
        </a>
      ))}
    </div>
    <p class="mt-4 text-sm text-stone-600">
      Matrices et configurateurs : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/compatibilite-interrupteur-connecte-sans-neutre/">interrupteur sans neutre</a>,
      <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/matrice-variateur-dimmer-ampoule-led-gu10-e27/">variateur × ampoule LED</a>,
      <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/configurateur-kit-eclairage-connecte-sans-neutre/">kit éclairage connecté</a>,
      <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/diagnostic-flicker-gu10-variateur-led/">diagnostic flicker GU10</a>,
      <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/matrice-matter-thread-philips-hue-aqara-govee/">Matter / Thread / Zigbee</a>.
    </p>
  </section>
  <FaqBlock title="Lumens et Kelvin : les questions qu’on nous pose le plus" items={HIVER_FAQ.outils} />
</Layout>
