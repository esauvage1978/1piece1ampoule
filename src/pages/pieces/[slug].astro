};
for (const k of ['chambre-adulte', 'bureau-adulte']) genericFaqBySlug[k] = [...(genericFaqBySlug[k] ?? []), ...HIVER_FAQ[k]];

const ZONE_LINKS: Record<string, [string, string][]> = { cuisine: [['/zones/plan-de-travail-cuisine/', 'Éclairer le plan de travail']], 'salle-de-bain': [['/zones/miroir-salle-de-bain/', 'Éclairer le miroir']], toilettes: [['/zones/miroir-salle-de-bain/', 'Éclairer le miroir']], jardin: [['/zones/entree-allee-exterieure/', 'Éclairer l’entrée et l’allée']], parking: [['/zones/entree-allee-exterieure/', 'Éclairer l’entrée et l’allée']], couloir: [['/zones/escaliers/', 'Éclairer un escalier'], ['/zones/placards-dressing/', 'Éclairer un placard']], 'chambre-adulte': [['/zones/placards-dressing/', 'Éclairer un placard ou un dressing']] };
---

<Layout title={seo?.title ?? `${page.title} — Choisir son ampoule`} description={seo?.description ?? page.description} type="article">
  <section class="mt-10 overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
    <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_1.15fr] lg:items-center">
      <div>
        {page.hero.eyebrow && <p class="text-sm font-semibold text-amber-700">{page.hero.eyebrow}</p>}
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{page.title}</h1>
        <figure class="mt-4 sm:hidden">
          <img
            src={page.hero.image}
            alt={page.hero.imageAlt}
            width="1200"
            height="780"
            class="h-auto max-h-44 w-full rounded-2xl object-cover object-center shadow-md ring-1 ring-stone-200"
            loading="eager"
            decoding="async"
          />
        </figure>
        {isCuisine && (
          <p class="mt-3 text-sm text-stone-600 sm:mt-4">
            Cette fiche fait partie de nos guides
            <a class="font-semibold text-amber-700 underline hover:text-amber-800" href="/pieces/"> pièce par pièce</a>.
          </p>
        )}
        {!isCuisine && (
          <p class="mt-3 text-sm text-stone-600 sm:mt-4">
            Retour aux <a class="font-semibold text-amber-700 underline hover:text-amber-800" href="/pieces/">guides éclairage par pièce</a>.
          </p>
        )}
        <p class="mt-4 max-w-2xl text-stone-600">{page.description}</p>
      </div>
      <div class="hidden sm:block">
        <img
          src={page.hero.image}
          alt={page.hero.imageAlt}
          width="1200" height="780"
          class="h-auto w-full rounded-2xl shadow-md ring-1 ring-stone-200"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <ComparisonTable products={tableTop} title={`Sélection rapide : ${page.title.split(/[:(]/)[0].trim()}`} placement="piece-table" />


  {isCuisine && (
    <section class="mt-10">
      <article class="rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
        <h2 class="text-xl font-extrabold">Cuisine : découper en zones pour choisir la bonne lumière</h2>
        <p class="mt-3 max-w-3xl text-sm text-stone-600">
          La cuisine se définit en <strong>4 zones</strong> : <strong>plan de travail</strong>, <strong>éclairage central</strong>,
          <strong>ambiance</strong>, et <strong>électroménager</strong>. Chaque zone a un objectif différent (précision, confort, déco, praticité) — donc des solutions différentes.
        </p>

        <figure class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
          <img
            src="/illustrations/cuisine-zones-v4.svg?v=3"
            alt="Cuisine découpée en 4 zones d’éclairage : plan de travail, central, ambiance, électroménager"
            class="h-auto w-full"
            loading="lazy"
          />
          <figcaption class="border-t border-stone-200 px-4 py-3 text-xs text-stone-500">
            Schéma : le plan de travail doit être éclairé “ciblé”, le central homogène, l’ambiance douce, l’électroménager spécifique.
          </figcaption>
        </figure>
      </article>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">1) Éclairage de travail (plan de travail)</h3>
          <p class="mt-3 text-sm text-stone-600">
            C’est la zone où tu coupes, cuisines, lis des étiquettes, nettoies. Le piège : l’ombre créée par ton corps si la lumière vient uniquement du plafond.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solutions top : <strong>réglettes/bandeaux sous-meubles</strong>, <strong>spots</strong> bien placés.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Teinte conseillée : <strong>blanc neutre ~4000K</strong> (couleur des aliments plus naturelle).</span></li>
            <li class="flex gap-2">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
              <span>
                Qualité : vise <strong><a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/irc-indice-rendu-couleur">IRC >= 90</a></strong> sur cette zone.
              </span>
            </li>
          </ul>

          <p class="mt-4 text-sm text-stone-600">
            Pour comparer des réglettes 230 V prêtes à poser (longueur, teinte, connectables), notre sélection
            <a class="font-semibold text-amber-700 hover:text-amber-800" href="/meilleur/meilleure-reglette-led-sous-meuble/">réglettes LED sous meuble</a>
            reprend les modèles les plus adaptés au plan de travail.
          </p>

          <div class="mt-5 grid gap-3">
            <ProductCard
              title="Réglette LED sous meuble (cuisine)"
              subtitle="Plan de travail sans ombre"
              keywords="reglette led sous meuble cuisine 4000k irc 90"
              altKeywords="eclairage sous meuble led cuisine 4000k irc 90"
              badge="Zone 1"
            />
            <ProductCard
              title="Ruban LED + profilé diffuseur"
              subtitle="Ligne lumineuse “premium”"
              keywords="ruban led cuisine 24v profilé aluminium diffuseur 4000k"
              altKeywords="ruban led sous meuble cuisine profilé aluminium diffuseur 4000k"
              badge="Zone 1"
            />
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">2) Éclairage central (général)</h3>
          <p class="mt-3 text-sm text-stone-600">
            Il sert à circuler confortablement et à avoir une lumière globale homogène. L’objectif n’est pas d’éclairer “à fond” le plan de travail : c’est le rôle de la zone 1.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solutions : plafonnier LED, spots encastrés, rail de spots.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Teinte : 3000–4000K selon ambiance souhaitée.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Astuce : plusieurs sources = moins d’éblouissement, meilleure uniformité.</span></li>
          </ul>

          <div class="mt-5 grid gap-3">
            <ProductCard
              title="Plafonnier LED cuisine"
              subtitle="Éclairage général homogène"
              keywords="plafonnier led cuisine 4000k irc 90"
              altKeywords="eclairage plafond led cuisine 4000k irc 90"
              badge="Zone 2"
            />
            <ProductCard
              title="Spots encastrables (lot)"
              subtitle="Modulaire et discret"
              keywords="spot encastrable led gu10 cuisine 4000k irc 90"
              altKeywords="spots encastres led cuisine 4000k irc 90"
              badge="Zone 2"
            />
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">3) Éclairage d’ambiance (cuisine = pièce de vie)</h3>
          <p class="mt-3 text-sm text-stone-600">
            Pour le coin repas, une cuisine ouverte ou simplement une ambiance agréable le soir, vise une lumière plus douce et plus chaude.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solutions : suspension au-dessus de l’îlot, ruban LED indirect, lampes d’appoint.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Teinte : <strong>2700–3000K</strong> (plus cosy).</span></li>
            <li class="flex gap-2">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
              <span>Le rendu le plus convaincant à l’œil : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/ampoules-dimmables-variateur"><strong>dimmable</strong></a> ou ampoule connectée (scènes).</span>
            </li>
          </ul>

          <div class="mt-5 grid gap-3">
            <ProductCard
              title="Suspension îlot cuisine"
              subtitle="Point focal + style"
              keywords="suspension ilot cuisine ampoule e27"
              altKeywords="suspension au dessus ilot cuisine led e27"
              badge="Zone 3"
            />
            <ProductCard
              title="Ampoule dimmable E27 2700K"
              subtitle="Ambiance modulable"
              keywords="ampoule led e27 dimmable 2700k"
              altKeywords="ampoule led e27 variable intensité 2700k"
              badge="Zone 3"
            />
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">4) Électroménager (ampoules spécifiques)</h3>
          <p class="mt-3 text-sm text-stone-600">
            Frigo, hotte, four, parfois micro-ondes : il existe des ampoules dédiées, souvent compactes, avec un culot particulier (ex. E14) et des contraintes de chaleur.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Vérifie : culot (E14/E27…), dimensions, température, compatibilité “four”.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Pour le frigo : faible puissance, allumage instantané, teinte souvent chaude/neutre.</span></li>
          </ul>

          <div class="mt-5 grid gap-3">
            <ProductCard
              title="Ampoule E14 pour réfrigérateur (LED)"
              subtitle="Compacte, allumage instantané"
              keywords="ampoule e14 refrigerateur led"
              altKeywords="ampoule e14 frigo led"
              badge="Zone 4"
            />
            <ProductCard
              title="Ampoule pour four haute température"
              subtitle="Spéciale chaleur"
              keywords="ampoule pour four e14 haute temperature"
              altKeywords="ampoule four e14 haute temperature led"
              badge="Zone 4"
            />
          </div>
        </article>
      </div>

      <section class="mt-10 rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
        <h2 class="text-xl font-extrabold">Mini-checklist “cuisine réussie”</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <ul class="space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Plan de travail : sous-meubles + 4000K + <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/irc-indice-rendu-couleur">IRC >= 90</a>.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Central : homogène, sans éblouissement.</span></li>
            <li class="flex gap-2">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
              <span>Ambiance : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/ampoules-dimmables-variateur">dimmable</a> / scènes.</span>
            </li>
          </ul>
          <ul class="space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Évite les ombres : multiplie les sources.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Choisis le bon culot : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/culots-e27-e14-gu10">guide culots</a>.</span></li>
            <li class="flex gap-2">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
              <span>
                Comprends lumens et watts : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/lumens-vs-watts">lumens vs watts</a> — Kelvin :
                <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/kelvin-temperature-couleur">température de couleur</a>.
              </span>
            </li>
          </ul>
        </div>
      </section>

      <section class="mt-10 rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
        <h2 class="text-xl font-extrabold">Questions fréquentes</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {cuisineFaq.map((f) => (
            <details class="rounded-2xl border border-stone-200 bg-stone-50 p-5">
              <summary class="cursor-pointer text-sm font-semibold text-stone-900">{f.q}</summary>
              <p class="mt-3 text-sm text-stone-600">{f.a}</p>
            </details>
          ))}
        </div>

        <script type="application/ld+json" set:html={JSON.stringify(cuisineJsonLd)} />
      </section>
    </section>
  )}

  {isGarage && (
    <section class="mt-10">
      <article class="rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
        <h2 class="text-xl font-extrabold">Garage : découpe en zones (stockage, établi, stationnement)</h2>
        <p class="mt-3 max-w-3xl text-sm text-stone-600">
          Un garage confortable, ce n’est pas “juste plus lumineux”. C’est un éclairage adapté à <strong>chaque usage</strong> : retrouver rapidement,
          travailler sans ombre, circuler en sécurité, et allumer automatiquement quand c’est utile.
          Ci-dessous, une découpe simple (comme un plan) pour choisir la bonne combinaison (réglettes, projecteurs, plafonniers, détecteurs).
        </p>

        <figure class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-stone-50">
          <img
            src="/illustrations/garage-zones-v2.svg?v=3"
            alt="Garage découpé en zones : stockage, établi, stationnement, entrée"
            class="h-auto w-full"
            loading="lazy"
          />
          <figcaption class="border-t border-stone-200 px-4 py-3 text-xs text-stone-500">
            Découpe : stockage (étagères) = lumière diffusée, établi = faisceau dirigé, stationnement = homogène au sol, entrée = détection.
          </figcaption>
        </figure>
      </article>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">Zone 1 : stockage (étagères, boîtes, outils)</h3>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Objectif : retrouver vite, sans “ombres en face” quand tu ouvres une boîte.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solution : réglettes/points lumineux à diffusion (idéalement en lignes).</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Repère : associe avec <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/kelvin-temperature-couleur">Kelvin</a> (souvent 4000K–5000K).</span></li>
          </ul>

          <div class="mt-5">
            <p class="text-xs font-semibold text-stone-500">Liens Amazon (pour acheter)</p>
            <div class="mt-3 grid gap-3">
              <ProductCard
                title="Reglette LED atelier (stockage/étagères)"
                subtitle="Lumiere diffusee, retrouve tes outils vite"
                keywords="reglette led atelier garage etagere 4000k"
                badge="Zone 1"
              />
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">Zone 2 : établi (précision, confort)</h3>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Objectif : voir la pièce et les détails sans ombre sur la table de travail.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solution : projecteur/panneau dirigé, ou réglette projetée, avec orientation.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Qualité : pense à <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/irc-indice-rendu-couleur">IRC</a> pour un rendu plus naturel.</span></li>
          </ul>

          <div class="mt-5">
            <p class="text-xs font-semibold text-stone-500">Liens Amazon (pour acheter)</p>
            <div class="mt-3 grid gap-3">
              <ProductCard
                title="Projecteur LED orientable (établi)"
                subtitle="Faisceau dirigé, précis et confortable"
                keywords="projecteur led orientable interieur etabli"
                badge="Zone 2"
              />
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">Zone 3 : stationnement / circulation</h3>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Objectif : éviter les “trous de lumière” (risque, sol glissant, sécurité).</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Solution : plafonnier/panneau puissant + plusieurs sources pour homogénéiser.</span></li>
            <li class="flex gap-2"><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber-500"></span><span>Repère : cadre lumens avec <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/lumens-vs-watts">lumens vs watts</a>.</span></li>
          </ul>

          <div class="mt-5">
            <p class="text-xs font-semibold text-stone-500">Liens Amazon (pour acheter)</p>
            <div class="mt-3 grid gap-3">
              <ProductCard
                title="Panneau LED / plafonnier puissant (circulation)"
                subtitle="Éclairage général homogène"
                keywords="panneau led plafond garage 4000k"
                badge="Zone 3"
              />
            </div>
          </div>
        </article>

        <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
          <h3 class="text-lg font-bold">Zone 4 : entrée (confort + automatismes)</h3>
          <ul class="mt-4 space-y-2 text-sm text-stone-600">
