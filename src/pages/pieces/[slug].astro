function normalizeText(input: string) {
  return input
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function extractZoneTitleFromPoint(point: string) {
  // Matches: Zone “poste de travail” : ...
  const quoted = point.match(/zone\s*[“"]([^”"]+)[”"]\s*:/i);
  if (quoted?.[1]) return quoted[1].trim();

  // Matches: Miroir/vasque : ...
  const colon = point.match(/^([^:]+?)\s*:\s*/);
  if (colon?.[1]) {
    return colon[1]
      .replace(/^zone\s+/i, '')
      .replace(/[“”"]/g, '')
      .trim();
  }

  // Fallback: keep as-is (shortened)
  return point.slice(0, 40).trim();
}

function splitProductsByZone({
  products,
  zoneTitles,
}: {
  products: Array<{ title: string; badge?: string }>;
  zoneTitles: string[];
}) {
  const normalizedZoneTitles = zoneTitles.map(normalizeText);
  const used = new Set<string>();
  const assigned: Array<typeof products> = zoneTitles.map(() => []);

  for (const p of products) {
    const badgeNorm = p.badge ? normalizeText(p.badge) : '';
    let bestIdx = -1;
    for (let i = 0; i < normalizedZoneTitles.length; i++) {
      const z = normalizedZoneTitles[i];
      if (!badgeNorm || !z) continue;
      if (badgeNorm.includes(z) || z.includes(badgeNorm)) {
        bestIdx = i;
        break;
      }
    }
    if (bestIdx >= 0) {
      assigned[bestIdx].push(p as any);
      used.add(p.title);
    }
  }

  // Fallback distribution if some zones are empty
  const allEmpty = assigned.every((a) => a.length === 0);
  if (allEmpty) {
    const perZone = Math.max(1, Math.ceil(products.length / zoneTitles.length));
    return zoneTitles.map((_, i) => products.slice(i * perZone, (i + 1) * perZone));
  }

  return assigned.map((arr, i) => {
    if (arr.length > 0) return arr;
    // If a zone is empty but others have data, distribute remaining products to it.
    const remaining = products.filter((p) => !used.has(p.title));
    if (remaining.length === 0) return arr;
    return [remaining.shift() as any].filter(Boolean);
  });
}

