                <h2 class="text-xl font-extrabold">{slug === 'bureau-adulte' ? 'Bureau : éclairage et zones' : slug === 'chambre-adulte' ? 'Chambre : ampoules, lecture et sommeil' : `Questions fréquentes : ${page.title.split(/[:(]/)[0].trim()}`}</h2>
                <div class="mt-6 grid gap-4 md:grid-cols-2">
                  {faq.map((f) => (
                    <details class="rounded-2xl border border-stone-200 bg-stone-50 p-5">
                      <summary class="cursor-pointer text-sm font-semibold text-stone-900">{f.q}</summary>
                      <p class="mt-3 text-sm text-stone-600">{f.a}</p>
                    </details>
                  ))}
                </div>
                <script
                  type="application/ld+json"
                  set:html={JSON.stringify(makeFaqJsonLd(faq))}
                />
              </section>
            );
          })()}
        </>
      ) : (
        <section class="mt-6 grid gap-4 md:grid-cols-2">
          {page.sections.map((s, idx) => {
            const start = idx * genericProductsPerSection;
            const end = start + genericProductsPerSection;
            const sectionProducts = page.products.slice(start, end);

            return (
              <article class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
                <h3 class="text-lg font-bold">{s.title}</h3>

                <ul class="mt-4 space-y-2 text-sm text-stone-600">
                  {s.points.map((pt) => (
                    <li class="flex gap-2">
                      <span class="mt-1 inline-block h-2 w-2 shrink-0 rounded-full bg-amber-500"></span>
                      <span set:html={pt} />
                    </li>
                  ))}
                </ul>

                {sectionProducts.length > 0 && (
                  <div class="mt-5">
                    <p class="text-xs font-semibold text-stone-500">Liens Amazon (pour acheter)</p>
                    <div class="mt-3 grid gap-3">
                      {sectionProducts.map((p) => (
                        <ProductCard
                          title={p.title}
                          subtitle={p.subtitle}
                          keywords={p.keywords}
                          altKeywords={p.altKeywords}
                          badge={p.badge}
                        />
                      ))}
                    </div>
                  </div>
                )}
              </article>
            );
          })}
        </section>
      )}
    </>
  )}

  <section class="mt-10 rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
    <h2 class="text-lg font-bold">À lire aussi</h2>
    <p class="mt-2 text-sm text-stone-600">
      Besoin de comprendre les bases ? Commence par nos guides : <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/lumens-vs-watts">lumens vs watts</a>, <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/kelvin-temperature-couleur">Kelvin</a>, <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/culots-e27-e14-gu10">culots</a> et <a class="font-semibold text-amber-700 hover:text-amber-800" href="/guides/irc-indice-rendu-couleur">IRC</a>.
      Pour un réglage rapide, utilise aussi <a class="font-semibold text-amber-700 hover:text-amber-800" href="/outils">l&apos;outil Lumens/Kelvin/IRC</a>.
    </p>
  </section>

  <HouseOfLampsPick />
  <AwinPartner />
{ZONE_LINKS[page.slug] && (
    <aside class="mx-auto mt-8 max-w-3xl rounded-2xl border border-amber-200 bg-amber-50 p-5"><p class="text-sm font-semibold text-stone-900">Zoom sur une zone de cette pièce</p><p class="mt-1 text-sm text-stone-700">{ZONE_LINKS[page.slug].map((z, i) => <>{i > 0 && ' · '}<a class="font-semibold text-amber-700 underline" href={z[0]}>{z[1]}</a></>)}</p></aside>
  )}
  <RelatedComparatifs slugs={seo?.related} />
</Layout>

