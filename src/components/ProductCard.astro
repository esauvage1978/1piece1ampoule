---
import AmazonButton from './AmazonButton.astro';

type Props = {
  title: string;
  subtitle?: string;
  keywords: string;
  altKeywords?: string;
  badge?: string;
};

const { title, subtitle, keywords, altKeywords, badge } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-5 shadow-sm backdrop-blur">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 class="truncate text-base font-semibold text-white">{title}</h3>
      {subtitle && <p class="mt-1 line-clamp-2 text-sm text-white/70">{subtitle}</p>}
    </div>
    {badge && (
      <span class="shrink-0 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/80 ring-1 ring-inset ring-white/10">
        {badge}
      </span>
    )}
  </div>

  <div class="mt-4 flex items-center justify-between gap-3">
    <p class="text-xs text-white/50">Lien partenaire Amazon</p>
    <div class="flex flex-col items-end gap-2">
      <AmazonButton keywords={keywords} label="Voir sur Amazon" />
      {altKeywords && (
        <details class="group [&_summary::-webkit-details-marker]:hidden">
          <summary class="cursor-pointer text-xs font-semibold text-amber-300 hover:text-amber-200">
            Autres options
          </summary>
          <div class="mt-2">
            <AmazonButton keywords={altKeywords} label="Option" class="!bg-white/10 !hover:bg-white/15" />
          </div>
        </details>
      )}
    </div>
  </div>
</article>

