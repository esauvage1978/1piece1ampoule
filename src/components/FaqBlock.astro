---
interface Props { title: string; items: { q: string; a: string }[] }
const { title, items } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="mt-10 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-xl font-extrabold text-stone-900">{title}</h2>
  <div class="mt-5 grid gap-3 md:grid-cols-2">
    {items.map((f) => (
      <details class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
        <summary class="cursor-pointer text-sm font-semibold text-stone-900">{f.q}</summary>
        <p class="mt-2 text-sm text-stone-600">{f.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
