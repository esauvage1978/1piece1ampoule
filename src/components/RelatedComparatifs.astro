---
import { COMPARATIFS } from '../content/comparatifs';
import { MEILLEUR_INDEXABLES } from '../content/meilleur-index.mjs';
type Props = { slugs?: string[]; title?: string };
const { slugs, title = 'Comparatifs 2026 à lire aussi' } = Astro.props;
const list = slugs && slugs.length ? COMPARATIFS.filter((c) => slugs.includes(c.slug)) : COMPARATIFS.filter((c) => MEILLEUR_INDEXABLES.includes(c.slug)).slice(0, 6);
---
<section class="mt-10 rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
  <h2 class="text-lg font-bold">{title}</h2>
  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
    {list.map((c) => (
      <li><a class="font-semibold text-amber-700 hover:text-amber-800" href={`/meilleur/${c.slug}/`}>{c.h1} →</a></li>
    ))}
  </ul>
</section>
