---
import { activePromos } from '../../content/promos';
import { awinLink } from '../../content/awin';

export type IntlLang = 'en' | 'de' | 'nl' | 'es' | 'it';
interface Props { lang: IntlLang }
const { lang } = Astro.props;
const promos = activePromos();

const tz: Record<IntlLang, string> = { en: 'Europe/London', de: 'Europe/Berlin', nl: 'Europe/Amsterdam', es: 'Europe/Madrid', it: 'Europe/Rome' };
const loc: Record<IntlLang, string> = { en: 'en-GB', de: 'de-DE', nl: 'nl-NL', es: 'es-ES', it: 'it-IT' };
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString(loc[lang] ?? 'en-GB', { timeZone: tz[lang] ?? 'Europe/London', day: '2-digit', month: '2-digit', year: 'numeric' });
const fmtDateTime = (iso: string) => new Date(iso).toLocaleString(loc[lang] ?? 'en-GB', { timeZone: tz[lang] ?? 'Europe/London', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

const T: Record<IntlLang, {
  title: string; desc: string; h1: string; lead: string; code: string; noCode: string; valid: string; verified: string; cta: string; brandLink: string;
  trotecKicker: string; trotecTitle: string; trotecBody: string; trotecCta: string;
  empty: string; compare: string; affiliate: string; affiliatePath: string; brandsPath: string;
}> = {
  en: {
    title: 'Lighting promo codes and deals — October 2026',
    desc: 'Verified lighting partner offers with codes, conditions and end dates.',
    h1: 'Lighting promo codes and deals',
    lead: 'Current discounts from lighting merchants we recommend: copy the code, read the conditions and note each offer’s end date.',
    code: 'Code:', noCode: 'No code needed — the discount applies automatically.',
    valid: 'Valid from', verified: 'Checked on', cta: 'Get the deal at',
    brandLink: 'Our review of {m}: delivery, warranty, support',
    trotecKicker: 'Trotec — Italy',
    trotecTitle: 'Climate, measurement and ventilation (IT store)',
    trotecBody: 'Dehumidifiers, heaters, fans and measuring tools on the Trotec Italy shop. No verified promo code today — see current deals on the merchant site.',
    trotecCta: 'View Trotec IT offers',
    empty: 'No active offers right now. Check back soon.',
    compare: 'Before buying, compare warranties and support on our',
    affiliate: 'Partner links: we may earn a commission if you buy, at no extra cost to you. Full terms on the merchant site.',
    affiliatePath: '/en/affiliate-disclosure/', brandsPath: '/en/brands/',
  },
  de: {
    title: 'Aktionscodes Beleuchtung — Oktober 2026',
    desc: 'Geprüfte Partnerangebote mit Codes und Enddatum.',
    h1: 'Aktionscodes und Angebote Beleuchtung',
    lead: 'Aktuelle Rabatte unserer empfohlenen Händler — Code, Bedingungen und Gültigkeit.',
    code: 'Code:', noCode: 'Kein Code nötig — Rabatt wird automatisch angewendet.',
    valid: 'Gültig vom', verified: 'Geprüft am', cta: 'Angebot bei',
    brandLink: 'Unser Test zu {m}: Lieferung, Garantie, Service',
    trotecKicker: 'Trotec — Italien',
    trotecTitle: 'Klima, Messung und Lüftung (IT-Shop)',
    trotecBody: 'Entfeuchter, Heizgeräte und Messgeräte im Trotec Italien Shop. Kein geprüfter Code — Angebote auf der Händlerseite.',
    trotecCta: 'Trotec IT Angebote',
    empty: 'Derzeit keine Angebote.',
    compare: 'Vergleichen Sie Garantien auf unserer',
    affiliate: 'Partnerlinks: Provision möglich, ohne Mehrkosten für Sie.',
    affiliatePath: '/de/affiliate-offenlegung/', brandsPath: '/de/marken/',
  },
  nl: {
    title: 'Actiecodes verlichting — oktober 2026',
    desc: 'Gecontroleerde partneraanbiedingen met codes en einddatum.',
    h1: 'Actiecodes en deals verlichting',
    lead: 'Huidige kortingen bij aanbevolen verlichtingswinkels — code, voorwaarden en einddatum.',
    code: 'Code:', noCode: 'Geen code nodig — korting wordt automatisch toegepast.',
    valid: 'Geldig van', verified: 'Gecontroleerd op', cta: 'Profiteer bij',
    brandLink: 'Onze review van {m}: levering, garantie, service',
    trotecKicker: 'Trotec — Italië',
    trotecTitle: 'Klimaat, meten en ventilatie (IT-winkel)',
    trotecBody: 'Ontvochtigers en meetapparatuur in de Trotec Italië shop. Geen geverifieerde code vandaag.',
    trotecCta: 'Trotec IT aanbiedingen',
    empty: 'Geen actieve aanbiedingen.',
    compare: 'Vergelijk garanties op onze',
    affiliate: 'Partnerlinks: commissie mogelijk, zonder meerprijs voor u.',
    affiliatePath: '/nl/affiliate-openbaarmaking/', brandsPath: '/nl/merken/',
  },
  es: {
    title: 'Códigos promo iluminación — octubre 2026',
    desc: 'Ofertas verificadas de socios con códigos y fecha de fin.',
    h1: 'Códigos promo y ofertas de iluminación',
    lead: 'Descuentos actuales de comercios que recomendamos: código, condiciones y caducidad.',
    code: 'Código:', noCode: 'Sin código: el descuento se aplica solo.',
    valid: 'Válido del', verified: 'Verificado el', cta: 'Aprovechar en',
    brandLink: 'Nuestra opinión sobre {m}: envío, garantía, SAV',
    trotecKicker: 'Trotec — Italia',
    trotecTitle: 'Climatización y medición (tienda IT)',
    trotecBody: 'Deshumidificadores y ventilación en Trotec Italia. Sin código verificado hoy.',
    trotecCta: 'Ver ofertas Trotec IT',
    empty: 'No hay ofertas activas.',
    compare: 'Compare garantías en nuestras',
    affiliate: 'Enlaces de afiliación: posible comisión sin coste extra.',
    affiliatePath: '/es/divulgacion-afiliados/', brandsPath: '/es/marcas/',
  },
  it: {
    title: 'Codici promo illuminazione — ottobre 2026',
    desc: 'Offerte partner verificate con codici e scadenza.',
    h1: 'Codici promo e offerte illuminazione',
    lead: 'Sconti attuali dai negozi consigliati: codice, condizioni e data di fine.',
    code: 'Codice:', noCode: 'Senza codice: lo sconto si applica da solo.',
    valid: 'Valido dal', verified: 'Verificato il', cta: 'Approfitta su',
    brandLink: 'La nostra recensione su {m}: consegna, garanzia, assistenza',
    trotecKicker: 'Trotec — Italia',
    trotecTitle: 'Clima, misura e ventilazione (shop IT)',
    trotecBody: 'Deumidificatori e strumenti sullo shop Trotec Italia. Nessun codice verificato oggi.',
    trotecCta: 'Offerte Trotec IT',
    empty: 'Nessuna offerta attiva.',
    compare: 'Confrontate garanzie sulle nostre',
    affiliate: 'Link partner: possibile commissione senza costi extra.',
    affiliatePath: '/it/informativa-affiliazione/', brandsPath: '/it/marchi/',
  },
};
const t = T[lang] ?? T.en;
const marqueEn = (p: string) => p.replace(/^\/marques\//, '/en/brands/').replace(/\/$/, '') + '/';
---
<section class="mt-10 max-w-3xl mx-auto">
  <h1 class="mt-8 text-3xl font-extrabold tracking-tight">{t.h1}</h1>
  <p class="mt-3 text-stone-600">{t.lead}</p>
  <div class="mt-6 space-y-4">
    {promos.map((p) => (
      <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-promo data-fin={p.fin}>
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{p.marchand}</p>
        <h2 class="mt-1 text-lg font-bold text-stone-900">{p.titre}</h2>
        <p class="mt-2 text-sm text-stone-600">{p.details}</p>
        {p.code ? <p class="mt-3 text-sm">{t.code} <strong class="rounded-lg border border-dashed border-amber-500 bg-amber-50 px-2 py-1 font-mono text-stone-900">{p.code}</strong></p> : <p class="mt-3 text-sm text-stone-700">{t.noCode}</p>}
        <p class="mt-3 text-xs text-stone-500">{t.valid} {fmtDate(p.debut)} — {fmtDateTime(p.fin)}. {t.verified} {p.verifie}.</p>
        <a href={p.lien} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={p.mid} data-product={`Promo ${p.marchand}`} class="mt-3 inline-flex items-center gap-2 rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.cta} {p.marchand}</a>
        {p.marquePage && <p class="mt-2 text-sm"><a class="text-amber-700 underline" href={lang === 'en' ? marqueEn(p.marquePage) : p.marquePage}>{t.brandLink.replace('{m}', p.marchand)}</a></p>}
      </article>
    ))}
  </div>
  <article class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{t.trotecKicker}</p>
    <h2 class="mt-1 text-lg font-bold text-stone-900">{t.trotecTitle}</h2>
    <p class="mt-2 text-sm text-stone-600">{t.trotecBody}</p>
    <a href={awinLink('115365', 'https://www.trotec.com/it/shop/')} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid="115365" class="mt-3 inline-flex rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.trotecCta}</a>
  </article>
  <p class="mt-6 text-sm text-stone-500" id="promo-empty" hidden>{t.empty}</p>
  <p class="mt-6 text-sm text-stone-600">{t.compare} <a class="font-semibold text-amber-700 underline" href={t.brandsPath}>{lang === 'en' ? 'brand pages' : t.brandsPath}</a>.</p>
  <p class="mt-6 text-xs text-stone-500">{t.affiliate} <a class="underline" href={t.affiliatePath}>{lang === 'en' ? 'Affiliate disclosure' : '…'}</a>.</p>
</section>
<script is:inline>
  (function(){var n=Date.now(),v=0;document.querySelectorAll('[data-promo]').forEach(function(e){if(new Date(e.dataset.fin).getTime()<=n){e.remove();}else v++;});if(!v){var m=document.getElementById('promo-empty');if(m)m.hidden=false;}})();
</script>
