  },
};
const t = T[lang] ?? T.en;
const marqueEn = (p: string) => p.replace(/^\/marques\//, '/en/brands/').replace(/\/$/, '') + '/';
const brandHrefForPromo = (marquePage: string) => {
  if (lang === 'en') return marqueEn(marquePage);
  if (lang === 'de') return marquePage.replace(/^\/marques\//, '/de/marken/');
  if (lang === 'nl') return marquePage.replace(/^\/marques\//, '/nl/merken/');
  if (lang === 'es') return marquePage.replace(/^\/marques\//, '/es/marcas/');
  if (lang === 'it') return marquePage.replace(/^\/marques\//, '/it/marchi/');
  return marquePage;
};
---
<section class="mt-10 max-w-3xl mx-auto">
  <BlackFridayStrip locale={bfLocale} />
  <figure class="not-prose mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
    <img src="/pins/e27-b22.png" alt={t.illuAlt} width="560" height="280" loading="lazy" class="mx-auto max-h-32 object-contain" />
  </figure>
  <h1 class="mt-8 text-3xl font-extrabold tracking-tight">{t.h1}</h1>
  <PageFreshness pathname={pathname} lang={displayLang} />
  <p class="mt-3 text-stone-600">{t.lead}</p>
  <p class="mt-3 text-stone-600">{t.extra}</p>
  <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 text-sm text-stone-700">
    <p class="font-semibold text-stone-900">{t.howTitle}</p>
    <ol class="mt-2 list-decimal space-y-1 pl-5">
      {t.steps.map((s) => <li>{s}</li>)}
    </ol>
    <p class="mt-3 text-xs text-stone-600"><a class="font-semibold text-amber-800 underline" href={t.bfPath}>{t.faqTitle}</a></p>
  </div>
  {promos.length > 0 && (
    <figure class="not-prose mt-8 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm">
      <table class="w-full min-w-[520px] text-sm">
        <caption class="px-4 pt-4 text-left text-sm font-semibold text-stone-900">{t.tableCap}</caption>
        <thead class="bg-stone-50 text-left"><tr>{t.th.map((h) => <th class="p-3">{h}</th>)}</tr></thead>
        <tbody>
          {promos.map((p) => (
            <tr class="border-t border-stone-100">
              <td class="p-3 font-medium">{p.marchand}</td>
              <td class="p-3 font-mono text-xs">{p.code ?? '—'}</td>
              <td class="p-3 text-stone-600">{p.titre}</td>
              <td class="p-3 text-stone-600">{fmtDateTime(p.fin)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </figure>
  )}
  <h2 class="mt-10 text-xl font-bold text-stone-900">{t.offersH2}</h2>
  <div class="mt-4 space-y-4">
    {promos.map((p) => (
      <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" data-promo data-fin={p.fin}>
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{p.marchand}</p>
        <h3 class="mt-1 text-lg font-bold text-stone-900">{p.titre}</h3>
        <p class="mt-2 text-sm text-stone-600">{p.details}</p>
        {p.code ? <p class="mt-3 text-sm">{t.code} <strong class="rounded-lg border border-dashed border-amber-500 bg-amber-50 px-2 py-1 font-mono text-stone-900">{p.code}</strong></p> : <p class="mt-3 text-sm text-stone-700">{t.noCode}</p>}
        <p class="mt-3 text-xs text-stone-500">{t.valid} {fmtDate(p.debut)} — {fmtDateTime(p.fin)}. {t.verified} {p.verifie}.</p>
        <a href={p.lien} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={p.mid} data-product={`Promo ${p.marchand}`} class="mt-3 inline-flex items-center gap-2 rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.cta} {p.marchand}</a>
        {p.marquePage && <p class="mt-2 text-sm"><a class="text-amber-700 underline" href={brandHrefForPromo(p.marquePage)}>{t.brandLink.replace('{m}', p.marchand)}</a></p>}
      </article>
    ))}
  </div>
  <article class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{t.osramK}</p>
    <h2 class="mt-1 text-lg font-bold text-stone-900">{t.osramH}</h2>
    <p class="mt-2 text-sm text-stone-600">{t.osramBody}</p>
    <a href={osramShop} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid="98739" class="mt-3 inline-flex items-center gap-2 rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.osramCta}</a>
  </article>
  <article class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{t.trotecKicker}</p>
    <h2 class="mt-1 text-lg font-bold text-stone-900">{t.trotecTitle}</h2>
    <p class="mt-2 text-sm text-stone-600">{t.trotecBody}</p>
    <a href={awinLink('115365', 'https://www.trotec.com/it/shop/')} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid="115365" class="mt-3 inline-flex rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.trotecCta}</a>
  </article>
  <p class="mt-6 text-sm text-stone-500" id="promo-empty" hidden>{t.empty} {t.emptyOsram}</p>
  <p class="mt-6 text-sm text-stone-600">{t.compare} <a class="font-semibold text-amber-700 underline" href={t.brandsPath}>{t.brandsLabel}</a>.</p>
  <p class="mt-6 text-xs text-stone-500">{t.affiliate} <a class="underline" href={t.affiliatePath}>{t.affiliateLink}</a>.</p>
</section>
<FaqBlock title={t.faqTitle} items={t.faq} />
<script is:inline>
  (function(){var n=Date.now(),v=0;document.querySelectorAll('[data-promo]').forEach(function(e){if(new Date(e.dataset.fin).getTime()<=n){e.remove();}else v++;});if(!v){var m=document.getElementById('promo-empty');if(m)m.hidden=false;}})();
</script>