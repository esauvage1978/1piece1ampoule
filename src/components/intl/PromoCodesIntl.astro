    faqTitle: 'Black Friday 2026 en verlichtingsdeals',
    faq: [
      { q: 'Wanneer is Black Friday 2026?', a: 'Vrijdag 27 november 2026, daarna Cyber Monday op 30 november.' },
      { q: 'Is er al een Hue-starterkitdeal?', a: 'Nog niet bij onze partners. Controleer fitting en lumen vóór u koopt.' },
