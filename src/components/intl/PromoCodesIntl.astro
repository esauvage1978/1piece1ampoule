---
import FaqBlock from '../FaqBlock.astro';
import BlackFridayStrip from '../BlackFridayStrip.astro';
import PageFreshness from '../hub/PageFreshness.astro';
import { activePromos } from '../../content/promos';
import { awinLink } from '../../content/awin';
import type { BFLocale } from '../../content/black-friday-2026';
import type { HubLang } from '../../content/hub-pages-i18n';

export type IntlLang = 'en' | 'de' | 'nl' | 'es' | 'it';
interface Props {
  lang: IntlLang;
  pathname: string;
  displayLang?: HubLang;
  bfLocale?: BFLocale;
}
const { lang, pathname, displayLang = lang, bfLocale = (displayLang === 'uk' || displayLang === 'ca' ? displayLang : lang) as BFLocale } = Astro.props;
const promos = activePromos();
const osramShop = awinLink('98739', 'https://shop.ledvance.fr/collections/all-stars');

const tz: Record<IntlLang, string> = { en: 'Europe/London', de: 'Europe/Berlin', nl: 'Europe/Amsterdam', es: 'Europe/Madrid', it: 'Europe/Rome' };
const loc: Record<IntlLang, string> = { en: 'en-GB', de: 'de-DE', nl: 'nl-NL', es: 'es-ES', it: 'it-IT' };
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString(loc[lang] ?? 'en-GB', { timeZone: tz[lang] ?? 'Europe/London', day: '2-digit', month: '2-digit', year: 'numeric' });
const fmtDateTime = (iso: string) => new Date(iso).toLocaleString(loc[lang] ?? 'en-GB', { timeZone: tz[lang] ?? 'Europe/London', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

const T: Record<IntlLang, {
  title: string; desc: string; h1: string; lead: string; extra: string; howTitle: string; steps: string[];
  tableCap: string; th: [string, string, string, string]; offersH2: string;
  code: string; noCode: string; valid: string; verified: string; cta: string; brandLink: string;
  trotecKicker: string; trotecTitle: string; trotecBody: string; trotecCta: string;
  osramK: string; osramH: string; osramBody: string; osramCta: string;
  empty: string; emptyOsram: string; compare: string; brandsLabel: string;
  affiliate: string; affiliateLink: string;
  faqTitle: string; faq: { q: string; a: string }[];
  illuAlt: string;
  affiliatePath: string; brandsPath: string; bfPath: string;
}> = {
