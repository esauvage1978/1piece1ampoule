  es: {
    title: 'Códigos promo iluminación — noviembre 2026',
    desc: 'Ofertas verificadas de socios con códigos y fecha de fin.',
    h1: 'Códigos promo y ofertas de iluminación',
    lead: 'Descuentos actuales de comercios que recomendamos: código, condiciones y caducidad.',
    extra: 'Antes de comprar, compare lúmenes y temperatura de color en nuestras guías. El descuento solo cuenta si aparece en el carrito antes del pago.',
    howTitle: 'Cómo usar un código promo',
