const t = T[lang] ?? T.en;
const inp = 'mt-1 w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200';
---
<section class="mt-10 rounded-3xl border border-stone-200 bg-white shadow-sm p-6 sm:p-8">
  <p class="text-sm font-semibold text-amber-700">{t.kicker}</p>
  <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{t.h1}</h1>
  <p class="mt-4 max-w-3xl text-stone-600">{t.lead1}</p>
  <p class="mt-3 max-w-3xl text-stone-600">{t.lead2}</p>
</section>
<section class="mt-8 grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
    <form id="contact-form" class="space-y-4" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-semibold text-stone-700">{t.name}
          <input class={inp} type="text" name="name" required maxlength="100" autocomplete="name" /></label>
        <label class="block text-sm font-semibold text-stone-700">{t.email}
          <input class={inp} type="email" name="email" required maxlength="150" autocomplete="email" /></label>
      </div>
      <label class="block text-sm font-semibold text-stone-700">{t.subject}
        <select class={inp} name="objet">{t.subjects.map((s) => <option value={s}>{s}</option>)}</select></label>
      <label class="block text-sm font-semibold text-stone-700">{t.message}
        <textarea class={inp} name="message" rows="7" required maxlength="5000" placeholder={t.placeholder}></textarea></label>
      <input type="hidden" name="page" value="" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;opacity:0;height:0;width:0;" aria-hidden="true" />
      <label class="flex items-start gap-2 text-sm text-stone-600">
        <input type="checkbox" name="rgpd" required class="mt-1 h-4 w-4 shrink-0 accent-amber-600" />
        <span>{t.rgpd} <a class="font-semibold text-amber-700 underline" href={t.privacyPath}>{t.privacyLabel}</a>. *</span>
      </label>
      <button type="submit" class="rounded-xl bg-amber-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-amber-700 disabled:opacity-60">{t.send}</button>
      <p id="contact-status" class="hidden rounded-xl px-4 py-3 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
  <aside class="space-y-4">
    <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6 text-sm text-stone-600">
      <h2 class="text-lg font-bold text-stone-900">{t.asideEmail}</h2>
      <p class="mt-2"><a class="font-semibold text-amber-700 break-all" href="mailto:contact@1piece1ampoule.fr">contact@1piece1ampoule.fr</a></p>
      <p class="mt-2" set:html={t.asideReply} />
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white shadow-sm p-6 text-sm">
      <h2 class="text-lg font-bold text-stone-900">{t.asideWait}</h2>
      <ul class="mt-3 space-y-2">{t.links.map(([href, label]) => <li><a class="font-semibold text-amber-700 hover:text-amber-800" href={href}>{label}</a></li>)}</ul>
    </div>
  </aside>
</section>
<script is:inline define:vars={{ okMsg: t.ok, errMsg: t.err, sendLabel: t.send, sendingLabel: t.sending, source: t.source }}>
(function(){
  var f=document.getElementById('contact-form'),st=document.getElementById('contact-status');
  if(!f)return;
  f.page.value=window.location.href;
  function show(ok,msg){st.className='rounded-xl px-4 py-3 text-sm '+(ok?'bg-green-50 text-green-800 border border-green-200':'bg-red-50 text-red-800 border border-red-200');st.innerHTML=msg;st.classList.remove('hidden');}
  f.addEventListener('submit',function(e){
    e.preventDefault();
    if(!f.checkValidity()){f.reportValidity();return;}
    var b=f.querySelector('button[type=submit]');b.disabled=true;b.textContent=sendingLabel;
    var body={name:f.name.value.trim(),email:f.email.value.trim(),objet:f.objet.value,message:f.message.value.trim(),page:f.page.value||document.referrer||window.location.pathname,website:f.website.value,source:source};
    fetch('/api/contact.php',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.json().catch(function(){return {};}).then(function(d){return r.ok&&d.ok;});})
      .then(function(ok){
        if(ok){show(true,okMsg);f.reset();f.page.value=window.location.href;}
        else throw 0;
      })
      .catch(function(){show(false,errMsg+' <a class="font-semibold underline" href="mailto:contact@1piece1ampoule.fr">contact@1piece1ampoule.fr</a>.');})
      .finally(function(){b.disabled=false;b.textContent=sendLabel;});
  });
})();
</script>
