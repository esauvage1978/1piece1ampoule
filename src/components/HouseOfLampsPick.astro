---
import { HOL_BY_PATH, HOL_MID, HOL_PRICE_DATE, holAwinHref, type HolPick } from '../content/houseOfLamps';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pick: HolPick | undefined = HOL_BY_PATH[path];
const href = pick ? holAwinHref(pick.merchantUrl) : '';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
---
{pick && (
  <aside class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50/80 to-white shadow-sm" data-awin-block>
    <div class="p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-amber-900">Lecteurs aux États-Unis · partenaire House of Lamps</p>
      <h2 class="mt-2 text-lg font-bold text-stone-900">Un luminaire en exemple pour cette pièce</h2>
      <p class="mt-3 text-sm leading-relaxed text-stone-700">{pick.blurb}</p>
      <p class="mt-3 text-sm leading-relaxed text-stone-700">
        Sur houseoflamps.com, le modèle <strong>{pick.nameFr}</strong> était affiché à <strong>{pick.priceUsd}&nbsp;$ US</strong> le {HOL_PRICE_DATE}
        (livraison États-Unis&nbsp;; ampoule souvent vendue à part, sauf LED intégrée). Ce n’est pas une offre Amazon.fr&nbsp;: utile surtout si tu commandes depuis les USA ou si tu compares des formes de luminaires avant d’acheter chez un marchand français.
      </p>
      <figure class="mt-5 overflow-hidden rounded-xl border border-stone-200 bg-white">
        <a href={href} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={HOL_MID} data-product={pick.nameFr} class="block">
          <img src={pick.image} alt={pick.nameFr} width="640" height="640" loading="lazy" decoding="async" class="mx-auto h-auto max-h-72 w-full object-contain p-4" />
        </a>
      </figure>
      <p class="mt-4 text-sm text-stone-700">
        Lien affilié visible&nbsp;:
        <Fragment set:html={`<a href="${esc(href)}" rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid="${HOL_MID}" data-product="${esc(pick.nameFr)}" class="font-semibold text-amber-800 underline break-all">${esc(pick.cta)}</a>`} />
      </p>
      <p class="mt-2 text-xs text-stone-500">
        Commission possible pour moi, sans surcoût pour toi — <a class="underline" href="/affiliation-amazon/">transparence affiliation</a>.
        Retour aux <a class="font-semibold text-amber-800 underline" href={pick.pillarHref}>{pick.pillarLabel}</a>.
      </p>
    </div>
  </aside>
)}
