---
import { AMZ_LOCAL, AMZ_SEL } from '../content/amz-local';
interface Props { lang: 'it' | 'es' | 'de'; path: string }
const { lang, path } = Astro.props;
const cfg = AMZ_LOCAL[lang];
const sel = AMZ_SEL[lang][path];
---
{sel && (
  <section class="mt-8 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8" data-amazon-local>
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{cfg.title}</p>
    <h2 class="mt-1 text-xl font-bold text-stone-900">{sel.h}</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {sel.items.map((x) => (
        <div class="flex flex-col rounded-2xl border border-stone-200 p-4">
          <strong class="text-stone-900">{x.name}</strong>
          <p class="mt-1 flex-1 text-sm text-stone-600">{x.text}</p>
          <a class="mt-3 inline-block self-start rounded-xl bg-gradient-to-br from-amber-400 to-orange-500 px-4 py-2 text-sm font-bold text-white" href={`https://${cfg.host}/dp/${x.asin}?tag=${cfg.tag}`} rel="sponsored nofollow noopener" target="_blank" data-amazon-link data-asin={x.asin} data-product={x.name}>{cfg.cta}</a>
        </div>
      ))}
    </div>
    <p class="mt-3 text-xs text-stone-500">{cfg.note}{' '}<a class="underline" href={cfg.moreHref}>{cfg.more}</a>.</p>
  </section>
)}
