---
const analyticsEnabledByDefault = false;
// Storage key used to remember user choice (v1, in case we change logic later)
const storageKey = 'cookie_consent_v1';
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-slate-950/95 backdrop-blur"
  style="display: none;"
>
  <div class="mx-auto max-w-6xl px-4 py-4">
    <div class="grid gap-4 md:grid-cols-[1fr_1fr] md:items-start">
      <div>
        <p class="text-sm font-semibold text-white">Gestion des cookies</p>
        <p class="mt-1 text-sm text-white/70">
          Nous utilisons des cookies uniquement pour optimiser l’analyse du trafic et améliorer le site. Tu peux accepter ou refuser.
        </p>
        <div class="mt-3 space-y-2">
          <label class="flex items-start gap-3 text-sm text-white/80">
            <input id="cookie-analytics" type="checkbox" class="mt-1" />
            <span>
              Statistiques (Google Analytics via gtag)
              <span class="block text-xs text-white/55">
                Nécessite ton accord pour charger les scripts d’analyse.
              </span>
            </span>
          </label>
        </div>
      </div>

      <div class="flex flex-col gap-2 md:items-end">
        <div class="flex flex-wrap gap-2">
          <button
            id="cookie-save"
            class="rounded-xl bg-amber-400 px-4 py-2 text-sm font-semibold text-slate-900 hover:bg-amber-300"
          >
            Enregistrer
          </button>
          <button
            id="cookie-accept-all"
            class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white/90 hover:bg-white/10"
          >
            Tout accepter
          </button>
          <button
            id="cookie-reject"
            class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white/90 hover:bg-white/10"
          >
            Refuser
          </button>
        </div>
        <a class="text-xs text-white/60 hover:text-white" href="/politique-de-cookies">Voir la politique de cookies</a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const storageKey = ${JSON.stringify(storageKey)};
    const banner = document.getElementById('cookie-banner');
    const cbAnalytics = document.getElementById('cookie-analytics');
    const btnSave = document.getElementById('cookie-save');
    const btnAcceptAll = document.getElementById('cookie-accept-all');
    const btnReject = document.getElementById('cookie-reject');

    const existing = localStorage.getItem(storageKey);

    function setBannerVisible(visible) {
      if (!banner) return;
      banner.style.display = visible ? 'block' : 'none';
    }

    function applyChoice(choice) {
      // choice: 'analytics' | 'none'
      localStorage.setItem(storageKey, choice);
      const enableAnalytics = window.__enableAnalyticsConsent;
      if (choice === 'analytics' && typeof enableAnalytics === 'function') {
        enableAnalytics();
      }
    }

    function showPreferences() {
      // Initialize checkbox based on saved choice
      if (existing === 'analytics') cbAnalytics.checked = true;
      if (existing === 'none') cbAnalytics.checked = false;
      // If no choice yet, default unchecked
      if (existing === null) cbAnalytics.checked = ${analyticsEnabledByDefault ? 'true' : 'false'};
      setBannerVisible(true);
    }

    if (existing === null) {
      showPreferences();
    } else {
      // Respect existing choice
      if (existing === 'analytics' && typeof window.__enableAnalyticsConsent === 'function') {
        window.__enableAnalyticsConsent();
      }
      setBannerVisible(false);
    }

    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const choice = cbAnalytics.checked ? 'analytics' : 'none';
        applyChoice(choice);
        existing = choice;
        setBannerVisible(false);
      });
    }

    if (btnAcceptAll) {
      btnAcceptAll.addEventListener('click', () => {
        applyChoice('analytics');
        existing = 'analytics';
        cbAnalytics.checked = true;
        setBannerVisible(false);
      });
    }

    if (btnReject) {
      btnReject.addEventListener('click', () => {
        applyChoice('none');
        existing = 'none';
        cbAnalytics.checked = false;
        setBannerVisible(false);
      });
    }

    // Public helper so the cookie policy page (or footer links) can reopen the banner.
    window.__showCookiePreferences = () => {
      showPreferences();
    };
  })();
</script>

