---
import FaqBlock from './FaqBlock.astro';
import Layout from '../layouts/Layout.astro';
import {
  type BFLocale,
  STRINGS,
  BF_UPDATED,
  offersForLocale,
  topOffers,
  groupByCategory,
  formatDate,
  statusLabel,
  flagForOffer,
  amazonForLocale,
  teasersForLocale,
  buyingGuides,
  faqItems,
  offerListSchema,
  affiliatePath,
  hubBase,
  categoryHref,
  categoryForOffer,
  CATEGORIES,
} from '../content/black-friday-2026';

interface Props {
  locale: BFLocale;
  catId?: string;
}

const { locale, catId } = Astro.props;
const t = STRINGS[locale];
const buildDate = new Date();
const allOffers = offersForLocale(locale, buildDate);
const groups = groupByCategory(allOffers);
const activeCat = catId ? CATEGORIES.find((c) => c.id === catId) : undefined;
const displayGroups = activeCat
  ? groups.filter((g) => g.cat?.id === activeCat.id)
  : groups;
const displayOffers = activeCat ? allOffers.filter((o) => categoryForOffer(o) === activeCat.id) : allOffers;
const highlights = topOffers(allOffers);
const amazon = amazonForLocale(locale);
const teasers = teasersForLocale(locale);
const guides = buyingGuides(locale, activeCat?.id);
const faq = faqItems(locale);
const pageUrl = activeCat ? `${hubBase(locale)}${activeCat.slug[locale]}/` : hubBase(locale);
const schemaExtra = offerListSchema(displayOffers, locale, pageUrl);
const title = activeCat
  ? `${t.categoryLabels[activeCat.id] ?? activeCat.id} — ${t.title.split('—')[0].trim()}`
  : t.title;
const h1 = activeCat ? `${t.categoryLabels[activeCat.id]} — Black Friday 2026` : t.h1;
const bfEnd = '2026-11-27T23:59:59+01:00';
const cmEnd = '2026-11-30T23:59:59+01:00';
const updatedFmt = formatDate(BF_UPDATED, locale);
const copyLabels = JSON.stringify({ copy: t.copy, copied: t.copied });
---

<Layout title={title} description={t.description} schema={schemaExtra}>
  <section class="mt-8 max-w-3xl">
    <p class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-stone-800">
      {t.disclosure}
      <a class="ml-1 font-semibold text-amber-800 underline" href={affiliatePath(locale)}>{t.affiliateMore}</a>.
    </p>
    <h1 class="mt-6 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">{h1}</h1>
    <p class="mt-3 text-stone-600">{t.intro}</p>
    <p class="mt-2 text-sm text-stone-500">{t.updatedLabel} {updatedFmt}</p>

    <div class="mt-6 grid gap-3 sm:grid-cols-2" data-bf-countdown data-bf={bfEnd} data-cm={cmEnd}>
      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{t.countdownBf}</p>
        <p class="mt-1 text-2xl font-bold tabular-nums text-stone-900" data-cd="bf">—</p>
        <p class="text-xs text-stone-500">27 novembre 2026</p>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">{t.countdownCm}</p>
        <p class="mt-1 text-2xl font-bold tabular-nums text-stone-900" data-cd="cm">—</p>
        <p class="text-xs text-stone-500">30 novembre 2026</p>
      </div>
    </div>
  </section>

  {!activeCat && highlights.length > 0 && (
    <section class="mt-10" id="top-offres">
      <h2 class="text-2xl font-bold text-stone-900">{t.topTitle}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {highlights.map((o) => (
          <article class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-5 shadow-sm">
            <div class="flex items-start justify-between gap-2">
              <p class="text-xs font-semibold uppercase text-amber-800">{o.merchant} {flagForOffer(o)}</p>
              {o.bf && <span class="rounded-full bg-stone-900 px-2 py-0.5 text-[10px] font-bold uppercase text-white">BF</span>}
            </div>
            <h3 class="mt-1 font-bold text-stone-900">{o.title}</h3>
            {o.pct > 0 && <p class="mt-1 text-sm font-semibold text-amber-700">−{o.pct} %</p>}
            <p class="mt-2 text-xs text-stone-500">{t.validFrom} {formatDate(o.start, locale)} {t.validUntil} {formatDate(o.end, locale)}</p>
            <span class="mt-2 inline-block rounded-lg bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-900">{statusLabel(o, locale)}</span>
            {o.code ? (
              <p class="mt-3 text-sm">
                Code : <code class="rounded-lg border border-dashed border-amber-500 bg-white px-2 py-1 font-mono">{o.code}</code>
                <button type="button" class="ml-2 rounded-lg border border-stone-300 px-2 py-0.5 text-xs font-semibold hover:bg-stone-100" data-copy-code={o.code}>{t.copy}</button>
              </p>
            ) : (
              <p class="mt-3 text-sm text-stone-600">{t.noCode}</p>
            )}
            <a href={o.url} rel="sponsored nofollow noopener" target="_blank" class="mt-3 inline-flex rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.cta}</a>
          </article>
        ))}
      </div>
    </section>
  )}

  {!activeCat && groups.some((g) => g.offers.length >= 4) && (
    <nav class="mt-10 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm" aria-label={t.navCategories}>
      <h2 class="text-lg font-bold text-stone-900">{t.navCategories}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {groups.map(({ cat, offers: olist }) =>
          cat && olist.length >= 4 ? (
            <li>
              <a class="rounded-xl bg-amber-100 px-3 py-2 text-sm font-semibold text-amber-950 hover:bg-amber-200" href={categoryHref(locale, cat)}>
                {t.categoryLabels[cat.id] ?? cat.id} ({olist.length})
              </a>
            </li>
          ) : null,
        )}
      </ul>
    </nav>
  )}

  {displayGroups.map(({ cat, offers: olist }) => {
    const anchor = cat ? cat.slug[locale] : 'autres';
    const catTitle = cat ? t.categoryLabels[cat.id] : t.otherCategory;
    return (
      <section class="mt-12" id={anchor}>
        <div class="flex flex-wrap items-end justify-between gap-2">
          <h2 class="text-2xl font-bold text-stone-900">{catTitle}</h2>
          {!activeCat && cat && olist.length >= 4 && (
            <a class="text-sm font-semibold text-amber-700 underline" href={categoryHref(locale, cat)}>{catTitle} →</a>
          )}
        </div>
        <ul class="mt-4 space-y-4">
          {olist.map((o) => (
            <li class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-semibold uppercase text-amber-700">{o.merchant}</span>
                <span aria-hidden="true">{flagForOffer(o)}</span>
                {o.bf && <span class="rounded bg-stone-900 px-1.5 py-0.5 text-[10px] font-bold text-white">BF</span>}
                <span class="rounded-lg bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-700">{statusLabel(o, locale)}</span>
              </div>
              <h3 class="mt-2 text-lg font-bold text-stone-900">{o.title}</h3>
              {o.pct > 0 && <p class="text-sm font-semibold text-amber-700">−{o.pct} %</p>}
              <p class="mt-1 text-sm text-stone-600 line-clamp-2">{o.description}</p>
              <p class="mt-2 text-xs text-stone-500">{t.validFrom} {formatDate(o.start, locale)} {t.validUntil} {formatDate(o.end, locale)}</p>
              {o.code ? (
                <p class="mt-3 text-sm">
                  <code class="rounded-lg border border-dashed border-amber-500 bg-amber-50 px-2 py-1 font-mono text-stone-900">{o.code}</code>
                  <button type="button" class="ml-2 rounded-lg border border-stone-300 bg-white px-2 py-1 text-xs font-semibold hover:bg-stone-50" data-copy-code={o.code}>{t.copy}</button>
                </p>
              ) : (
                <p class="mt-3 text-sm text-stone-600">{t.noCode}</p>
              )}
              <a href={o.url} rel="sponsored nofollow noopener" target="_blank" data-awin-link class="mt-3 inline-flex rounded-xl bg-stone-900 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">{t.cta} — {o.merchant}</a>
            </li>
          ))}
        </ul>
        {cat && (
          <div class="mt-6 rounded-2xl border border-stone-100 bg-stone-50 p-4">
            <h3 class="text-sm font-bold text-stone-900">{t.adviceTitle}</h3>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {buyingGuides(locale, cat.id).map((g) => (
                <li><a class="font-semibold text-amber-800 underline" href={g.href}>{g.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    );
  })}

  {amazon && (
    <section class="mt-12 rounded-2xl border border-orange-200 bg-orange-50 p-6 shadow-sm" id="amazon-bf">
      <h2 class="text-xl font-bold text-stone-900">{t.amazonTitle}</h2>
      <p class="mt-2 text-sm text-stone-700">{amazon.note}</p>
      <a href={amazon.url} rel="sponsored nofollow noopener" target="_blank" class="mt-4 inline-flex rounded-xl bg-orange-500 px-5 py-3 font-semibold text-white hover:bg-orange-600">{amazon.label} →</a>
    </section>
  )}

  <section class="mt-12 max-w-3xl rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" id="verifier-prix">
    <h2 class="text-xl font-bold text-stone-900">{t.verifyTitle}</h2>
    <p class="mt-3 text-sm text-stone-700">{t.verifyBody}</p>
  </section>

  {!activeCat && (
    <section class="mt-10 max-w-3xl">
      <h2 class="text-lg font-bold text-stone-900">{t.adviceTitle}</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-stone-700">
        {guides.map((g) => (
          <li><a class="font-semibold text-amber-800 underline" href={g.href}>{g.label}</a></li>
        ))}
      </ul>
    </section>
  )}

  {teasers.length > 0 && (
    <section class="mt-12 rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-6" id="teasers">
      <h2 class="text-xl font-bold text-stone-900">{t.teasersTitle}</h2>
      <p class="mt-1 text-sm text-stone-600">{t.teasersNote}</p>
      <ul class="mt-4 space-y-4">
        {teasers.map((te) => (
          <li class="rounded-xl border border-stone-200 bg-white p-4 text-sm">
            <p class="font-semibold text-stone-900">{te.merchant} · {te.region}</p>
            {te.dates && <p class="mt-1 text-stone-600">{te.dates}</p>}
            {te.discount && <p class="text-stone-600">{te.discount}</p>}
            {te.quote && <p class="mt-2 italic text-stone-500">« {te.quote} »</p>}
            <p class="mt-2 text-xs text-stone-500">
              Source : <a href={te.source_url} rel="nofollow noopener" target="_blank" class="underline">{te.source_url}</a>
              · contrôle {te.checked}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script type="application/json" id="bf-copy-labels">{copyLabels}</script>

  <FaqBlock title={t.faqTitle} items={faq} />

  {activeCat && (
    <p class="mt-8 text-sm">
      <a class="font-semibold text-amber-700 underline" href={hubBase(locale)}>← {locale === 'fr' ? 'Toutes les offres Black Friday 2026' : 'All Black Friday 2026 deals'}</a>
    </p>
  )}

  <script is:inline>
    (function () {
      var labelsEl = document.getElementById('bf-copy-labels');
      var labels = labelsEl ? JSON.parse(labelsEl.textContent || '{}') : { copy: 'Copy', copied: 'Copied' };
      document.querySelectorAll('[data-copy-code]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const code = btn.getAttribute('data-copy-code');
          if (!code) return;
          navigator.clipboard.writeText(code).then(function () {
            const prev = btn.textContent;
            btn.textContent = labels.copied;
            setTimeout(function () { btn.textContent = prev || labels.copy; }, 1500);
          });
        });
      });
      var root = document.querySelector('[data-bf-countdown]');
      if (!root) return;
      var bf = new Date(root.getAttribute('data-bf')).getTime();
      var cm = new Date(root.getAttribute('data-cm')).getTime();
      function tick() {
        var now = Date.now();
        [['bf', bf], ['cm', cm]].forEach(function (pair) {
          var el = root.querySelector('[data-cd="' + pair[0] + '"]');
          if (!el) return;
          var diff = pair[1] - now;
          if (diff <= 0) { el.textContent = '0 j'; return; }
          var d = Math.floor(diff / 86400000);
          var h = Math.floor((diff % 86400000) / 3600000);
          el.textContent = d + ' j ' + h + ' h';
        });
      }
      tick();
      setInterval(tick, 60000);
    })();
  </script>
</Layout>
