---
import { QUICK_ACCESS_STATIC, QUICK_ACCESS_BUTTONS_HOME } from '../data/siteQuickAccess.mjs';
import { getCatalogFr, urlFicheErreur } from '../data/errors/catalog';

interface Props {
  mode?: 'home' | '404';
  showButtons?: boolean;
  id?: string;
}
const { mode = 'home', showButtons = mode === 'home', id = 'quick-access-hub' } = Astro.props;

const catalog = getCatalogFr();
const ficheItems = catalog.errors.map((e) => ({
  title: `${e.error_code} — ${e.title}`,
  href: urlFicheErreur(e.slug),
  keywords: `${e.error_code} ${e.title} ${e.symptom} ${e.brand_slug} ${e.product_slug}`,
  category: 'code',
}));
const searchItems = [...QUICK_ACCESS_STATIC, ...ficheItems];
const searchJson = JSON.stringify(searchItems);

const title =
  mode === '404'
    ? 'Retrouvez un outil ou un code erreur'
    : 'Accès rapide en 1 clic — Configurateurs, Outils & Codes erreurs';
const subtitle =
  mode === '404'
    ? 'Tapez un mot-clé : configurateur, modèle, symptôme ou code erreur.'
    : 'Recherche instantanée sans rechargement, puis accès direct en un clic.';
---

<section
  id={id}
  class="quick-access-hub mt-6 rounded-3xl border border-amber-200/80 bg-gradient-to-br from-amber-50 via-white to-stone-50 p-5 shadow-sm sm:mt-8 sm:p-7"
  aria-labelledby={`${id}-title`}
>
  <h2 id={`${id}-title`} class="text-xl font-bold text-stone-900 sm:text-2xl">{title}</h2>
  <p class="mt-1 text-sm text-stone-600">{subtitle}</p>

  <label class="mt-4 block">
    <span class="sr-only">Rechercher un configurateur, un guide ou un code erreur</span>
    <input
      type="search"
      class="quick-access-input w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-base text-stone-900 shadow-inner placeholder:text-stone-400 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-200"
      placeholder="Rechercher un configurateur, un modèle ou un code erreur…"
      autocomplete="off"
      enterkeyhint="search"
      data-quick-access-input
    />
  </label>

  <p class="mt-2 hidden text-sm text-stone-500" data-quick-access-empty role="status">Aucun résultat — essayez « Hue », « GU10 », « variateur » ou un code erreur.</p>

  <ul class="mt-3 max-h-64 space-y-1 overflow-y-auto rounded-xl border border-stone-200 bg-white p-2 shadow-inner sm:max-h-72" data-quick-access-results aria-live="polite" hidden></ul>

  {showButtons && (
    <div class="mt-4 flex flex-wrap gap-2">
      {QUICK_ACCESS_BUTTONS_HOME.map((b) => (
        <a
          href={b.href}
          class:list={[
            'rounded-xl px-3 py-2 text-sm font-semibold transition',
            b.accent
              ? 'bg-amber-500 text-white shadow hover:bg-amber-600'
              : 'border border-stone-200 bg-white text-stone-800 hover:border-amber-300 hover:bg-amber-50',
          ]}
        >
          {b.label}
        </a>
      ))}
    </div>
  )}
</section>

<script define:vars={{ searchJson, hubId: id }}>
  const items = JSON.parse(searchJson);
  const root = document.getElementById(hubId);
  if (root) {
  const input = root.querySelector('[data-quick-access-input]');
  const list = root.querySelector('[data-quick-access-results]');
  const empty = root.querySelector('[data-quick-access-empty]');
  const catLabel = { outil: 'Outil', depannage: 'Dépannage', code: 'Code erreur', guide: 'Guide' };

  const norm = (s) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{M}/gu, '');

  function render(q) {
    const query = norm(q.trim());
    if (!query) { list.innerHTML = ''; list.hidden = true; empty?.classList.add('hidden'); return; }
    list.hidden = false;
    const max = query ? 24 : 12;
    const filtered = query
      ? items.filter((it) => norm(`${it.title} ${it.keywords}`).includes(query))
      : items.filter((it) => it.category === 'outil' || it.category === 'depannage').slice(0, max);
    const show = filtered.slice(0, max);
    list.innerHTML = '';
    if (!show.length) {
      empty?.classList.remove('hidden');
      return;
    }
    empty?.classList.add('hidden');
    for (const it of show) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = it.href;
      a.className =
        'flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-medium text-stone-800 hover:bg-amber-50 hover:text-amber-900';
      const left = document.createElement('span');
      left.textContent = it.title;
      const badge = document.createElement('span');
      badge.className = 'shrink-0 text-xs font-semibold uppercase tracking-wide text-stone-400';
      badge.textContent = catLabel[it.category] ?? it.category;
      a.append(left, badge);
      li.append(a);
      list.append(li);
    }
  }

  input?.addEventListener('input', () => render(input.value));
  render('');
  }
</script>
