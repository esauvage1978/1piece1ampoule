---
import { activePromos } from '../content/promos';
import { ECHOIX_BY_PATH, ECHOIX_MID, ECHOIX_PRICE_DATE, LUMINAIRE_BY_PATH, LUMINAIRE_MID, OSRAM_BY_PATH, OSRAM_MID, CH_MID, CH_FR_URL, CH_FR_PATHS, awinLink } from '../content/awin';
const p = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const entry = LUMINAIRE_BY_PATH[p];
const osram = OSRAM_BY_PATH[p];
const echoix = ECHOIX_BY_PATH[p];
const osramHref = osram ? awinLink(OSRAM_MID, `https://shop.ledvance.fr${osram.path}`) : '';
const href = entry ? awinLink(LUMINAIRE_MID, `https://www.luminaire.fr${entry.path}`) : '';
const ch = CH_FR_PATHS.has(p);
const promoMids = new Set(activePromos().map((x) => x.mid));
---
{entry && (
  <aside class="mx-auto mt-10 max-w-3xl rounded-2xl border border-stone-200 bg-stone-50 p-5" data-awin-block>
    <p class="text-sm font-semibold text-stone-900">Envie de comparer avec un spécialiste du luminaire ?</p>
    <p class="mt-1 text-sm text-stone-600">Au-delà d’Amazon, Luminaire.fr propose {entry.blurb ?? `un large choix de ${entry.label}`}, avec des marques comme Philips, Paulmann ou Lindby.</p>
    <a href={href} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={LUMINAIRE_MID} data-product={`Luminaire.fr : ${entry.label}`} class="mt-3 inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-800 hover:border-amber-400">
      {entry.linkLabel ?? `Voir les ${entry.label} sur Luminaire.fr`}
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M11 3h6v6h-2V6.4l-6.3 6.3-1.4-1.4L13.6 5H11V3ZM4 5h5v2H5v8h8v-4h2v6H3V5h1Z"/></svg>
    </a>
    {promoMids.has(LUMINAIRE_MID) && <p class="mt-2 text-sm"><a class="font-semibold text-amber-700 underline" href="/codes-promo/">Code promo en cours : voir l’offre datée</a></p>}
    <p class="mt-2 text-sm"><a class="text-amber-700 underline" href="/marques/luminaire-fr/">Notre avis sur Luminaire.fr : livraison, retours, SAV</a></p>
    <p class="mt-2 text-xs text-stone-500">Lien partenaire : une commission peut m’être versée, sans surcoût pour toi. <a class="underline" href="/affiliation-amazon/">En savoir plus</a>.</p>
  </aside>
)}
{osram && (
  <aside class="mx-auto mt-6 max-w-3xl rounded-2xl border border-stone-200 bg-stone-50 p-5" data-awin-block>
    <p class="text-sm font-semibold text-stone-900">Acheter directement chez le fabricant</p>
    <p class="mt-1 text-sm text-stone-600">La boutique officielle OSRAM (LEDVANCE) vend toute la gamme : {osram.label}, avec les fiches techniques complètes.</p>
    <a href={osramHref} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={OSRAM_MID} data-product={`OSRAM : ${osram.label}`} class="mt-3 inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-800 hover:border-amber-400">
      Voir les {osram.label} sur la boutique OSRAM
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M11 3h6v6h-2V6.4l-6.3 6.3-1.4-1.4L13.6 5H11V3ZM4 5h5v2H5v8h8v-4h2v6H3V5h1Z"/></svg>
    </a>
    {promoMids.has(OSRAM_MID) && <p class="mt-2 text-sm"><a class="font-semibold text-amber-700 underline" href="/codes-promo/">Code promo en cours : voir l’offre datée</a></p>}
    <p class="mt-2 text-sm"><a class="text-amber-700 underline" href="/marques/osram-ledvance/">Notre avis sur OSRAM : produits, garantie, SAV</a></p>
    <p class="mt-2 text-xs text-stone-500">Lien partenaire : une commission peut m’être versée, sans surcoût pour toi. <a class="underline" href="/affiliation-amazon/">En savoir plus</a>.</p>
  </aside>
)}
{echoix && (
  <aside class="mx-auto mt-6 max-w-3xl rounded-2xl border border-stone-200 bg-stone-50 p-5" data-awin-block>
    <p class="text-sm font-semibold text-stone-900">Petit budget : en déstockage chez 2echoix</p>
    <p class="mt-1 text-sm text-stone-600">2echoix vend des produits de deuxième choix à prix réduit. Prix relevés le {ECHOIX_PRICE_DATE}, susceptibles d’avoir changé :</p>
    <ul class="mt-3 space-y-2">
      {echoix.map((e) => (
        <li><a href={e.url} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={ECHOIX_MID} data-product={`2echoix : ${e.name}`} class="text-sm font-semibold text-stone-800 underline hover:text-amber-700">{e.name}</a> <span class="text-sm text-stone-600">— {e.price}</span></li>
      ))}
    </ul>
    <p class="mt-2 text-xs text-stone-500">Lien partenaire : une commission peut m’être versée, sans surcoût pour toi. <a class="underline" href="/affiliation-amazon/">En savoir plus</a>.</p>
  </aside>
)}
{ch && (
  <aside class="mx-auto mt-6 max-w-3xl rounded-2xl border border-stone-200 bg-stone-50 p-5" data-awin-block>
    <p class="text-sm font-semibold text-stone-900">Pour nos lecteurs en Suisse</p>
    <p class="mt-1 text-sm text-stone-600">Lumories, la boutique francophone de Lampenwelt Suisse, vend des ampoules LED dans tous les culots, avec livraison en Suisse.</p>
    <a href={awinLink(CH_MID, CH_FR_URL)} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid={CH_MID} data-product="Lampenwelt CH (Lumories) : ampoules" class="mt-3 inline-flex items-center gap-2 rounded-xl border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-800 hover:border-amber-400">
      Voir les ampoules sur Lumories.ch
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M11 3h6v6h-2V6.4l-6.3 6.3-1.4-1.4L13.6 5H11V3ZM4 5h5v2H5v8h8v-4h2v6H3V5h1Z"/></svg>
    </a>
    <p class="mt-2 text-xs text-stone-500">Lien partenaire : une commission peut m’être versée, sans surcoût pour toi. <a class="underline" href="/affiliation-amazon/">En savoir plus</a>.</p>
  </aside>
)}
