---
import Layout from '../../layouts/Layout.astro';
import FaqBlock from '../FaqBlock.astro';
import PageFreshness from './PageFreshness.astro';
import { MARQUES } from '../../content/marques';
import { activePromos } from '../../content/promos';
import { HUB_BRANDS, hubBrandPrefix, type HubLang } from '../../content/hub-pages-i18n';

interface Props { lang: HubLang; pathname: string }
const { lang, pathname } = Astro.props;
const t = HUB_BRANDS[lang];
const mids = new Set(activePromos().map((p) => p.mid));
const base = hubBrandPrefix(lang);
const faq = [
  {
    q: lang === 'fr' ? 'Quelle garantie sur une ampoule LED achetée en France ?' : lang === 'de' ? 'Welche Garantie gilt für LED-Lampen in der EU?' : 'What warranty applies to LED bulbs in the EU?',
    a: lang === 'fr'
      ? 'Deux ans de garantie légale de conformité auprès du vendeur, plus la garantie commerciale fabricant indiquée sur la fiche ou l’emballage.'
      : 'Two-year legal conformity against the seller in the EU, plus any manufacturer warranty stated on the pack.',
  },
  {
    q: lang === 'fr' ? 'OSRAM LEDVANCE a-t-il un code promo en cours ?' : 'Is there an active OSRAM promo code?',
    a: lang === 'fr'
      ? 'Les offres datées figurent sur la page codes promo. Une remise ne compte que si elle apparaît au panier avant paiement.'
      : 'Dated offers are listed on the promo codes hub. A discount only counts if it appears in the basket before checkout.',
  },
  {
    q: lang === 'fr' ? 'Hue ou Tapo pour débuter ?' : lang === 'de' ? 'Hue oder Tapo zum Einstieg?' : 'Hue or Tapo to start?',
    a: lang === 'fr'
      ? 'Tapo (Wi-Fi) pour une ou deux ampoules sans pont ; Hue (Zigbee) pour une maison entière et des blancs plus fiables.'
      : 'Tapo (Wi-Fi) for one or two bulbs without a hub; Hue (Zigbee) for a whole home and more reliable whites.',
  },
];
---
<Layout title={t.title} description={t.description}>
  <section class="mt-10 rounded-3xl border border-stone-200 bg-white shadow-sm p-8">
    <figure class="not-prose mb-6">
      <img src="/pins/e27-b22.png" alt={t.illuAlt} width="560" height="320" loading="lazy" class="mx-auto max-h-36 object-contain" />
    </figure>
    <p class="text-sm font-semibold text-amber-700">{t.kicker}</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{t.h1}</h1>
    <PageFreshness pathname={pathname} lang={lang} />
    <p class="mt-4 max-w-3xl text-stone-600">{t.lead}</p>
    <p class="mt-4 text-sm text-stone-600">
      <a class="font-semibold text-amber-700 underline" href={t.osramHref} rel="sponsored nofollow noopener" target="_blank" data-awin-link data-awin-mid="98739">{t.osramCta}</a>
      {' · '}
      <a class="font-semibold text-amber-700 underline" href={t.promoPage}>{t.promoPageLabel}</a>
    </p>
  </section>
  <section class="mt-10 overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-sm p-6">
    <h2 class="text-lg font-bold">{t.tableTitle}</h2>
    <table class="mt-4 w-full min-w-[640px] text-left text-sm">
      <thead><tr class="border-b border-stone-200 text-stone-500">
        {t.th.map((h) => <th class="py-2 pr-3">{h}</th>)}
      </tr></thead>
      <tbody>
        {MARQUES.map((m) => (
          <tr class="border-b border-stone-100 align-top">
            <td class="py-2 pr-3">
              <a class="font-semibold text-amber-800 underline" href={`${base}${m.slug}/`}>{m.name}</a>
              {m.promoMid && mids.has(m.promoMid) && (
                <>
                  <br />
                  <a class="text-xs font-semibold text-amber-700 underline" href={t.promoPage}>{t.promoLink}</a>
                </>
              )}
            </td>
            <td class="py-2 pr-3">{m.type}</td>
            <td class="py-2 pr-3">{m.produits}</td>
            <td class="py-2 pr-3">{m.garantie}</td>
            <td class="py-2 pr-3">{m.avis}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-4 text-xs text-stone-500">{t.legalNote}</p>
  </section>
  <FaqBlock title={t.faqTitle} items={faq} />
</Layout>